<Window x:Class="SmithForge.Features.StreamsManager.ChatLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.StreamsManager"
        xmlns:utils="clr-namespace:SmithForge.Main.Converters"
        mc:Ignorable="d"
        Title="Лог сообщений стрима" Height="600" Width="750" 
        WindowStartupLocation="CenterOwner" Background="#F9F9F9">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:UnixToDateTimeConverter x:Key="UnixConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК И СТАТИСТИКА -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="ИСТОРИЯ ЧАТА" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,20,0"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📊 Всего: " Foreground="#666"/>
                <TextBlock Text="{Binding LogsCount}" FontWeight="Bold" Foreground="#2A5BB1" Margin="0,0,10,0"/>

                <TextBlock Text="👍 " Foreground="#4CAF50"/>
                <TextBlock Text="{Binding TotalLikes}" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,10,0"/>

                <TextBlock Text="👎 " Foreground="#F44336"/>
                <TextBlock Text="{Binding TotalDislikes}" Foreground="#F44336" FontWeight="Bold"/>
            </StackPanel>

            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                    Margin="20,0,0,0" Padding="8,2" FontSize="11"
                    Background="#E0E0E0" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- ПАНЕЛЬ ПОИСКА -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="Gray" FontSize="12"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         BorderThickness="0" VerticalContentAlignment="Center" FontSize="13" Background="Transparent"/>
            </Grid>
        </Border>

        <!-- СПИСОК СООБЩЕНИЙ -->
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredLogs}" 
                 BorderThickness="1" BorderBrush="#E0E0E0" Padding="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Номер сообщения -->
                            <TextBlock Grid.Column="0" 
           Text="{Binding MessageNumber, StringFormat=#{0}}" 
           Foreground="#666" FontSize="10" 
           VerticalAlignment="Top" Margin="0,2,5,0"/>

                            <!-- Время -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Timestamp, Converter={StaticResource UnixConverter}}" 
                                       Foreground="#888" FontSize="11" 
                                       VerticalAlignment="Top" Margin="0,2,0,0"/>

                            <!-- ЛАЙКИ И ДИЗЛАЙКИ (после времени) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,10,0">
                                <Button Command="{Binding DataContext.LikeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" 
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👍 " FontSize="12"/>
                                        <TextBlock Text="{Binding Likes}" Foreground="#4CAF50" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DataContext.DislikeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" 
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👎 " FontSize="12"/>
                                        <TextBlock Text="{Binding Dislikes}" Foreground="#F44336" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Ник автора -->
     
                            <TextBlock Grid.Column="3" 
           Text="{Binding Author, StringFormat=\{0\}:\ }" 
           FontWeight="Bold" Foreground="#2A5BB1" 
           Margin="0,0,10,0" VerticalAlignment="Top"/>

                            <!-- Текст сообщения -->
                            <TextBlock Grid.Column="4" 
                                       Text="{Binding Message}" 
                                       TextWrapping="Wrap" Foreground="#333" FontSize="13"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>