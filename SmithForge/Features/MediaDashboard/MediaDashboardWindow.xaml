<Window x:Class="SmithForge.Features.MediaDashboard.MediaDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.MediaDashboard"
        xmlns:conv="clr-namespace:SmithForge.Main.Converters"
        mc:Ignorable="d"
        Title="🎨 Media Dashboard"
        Height="600" Width="450"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Topmost="False"
        ShowInTaskbar="True"
        Visibility="Collapsed"
        ShowActivated="True"
        ResizeMode="CanResize"
        Background="#232323">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#9147ff"/>
                    <Setter Property="Background" Value="#3a3a3a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для скроллбара -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track"
                                   Grid.Row="1"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#555555"
                                                        CornerRadius="4"
                                                        Height="40"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Верхняя панель с заголовком и кнопками -->
        <Border Height="45" VerticalAlignment="Top" Background="#333">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🎨 MEDIA"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="🗑"
                            Command="{Binding ClearCommand}"
                            ToolTip="Очистить все медиа"/>

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="✕"
                            Command="{Binding CloseCommand}"
                            ToolTip="Закрыть дашборд"
                            Foreground="#FF6B6B"
                            Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список -->
        <ScrollViewer x:Name="EventsScrollViewer"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#232323"
                      Margin="0,45,0,0"
                      Padding="0,0,0,0"
                      ScrollChanged="EventsScrollViewer_ScrollChanged">
            <ItemsControl x:Name="MessagesList"
                          ItemsSource="{Binding Items}"
                          IsHitTestVisible="True"
                          Margin="10,10,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="MediaGrid"
                              Margin="0,2,0,2"
                              Background="Transparent">

                            <Border Background="#2A2A3A"
                                    BorderBrush="#3A3A5A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8">
                                <StackPanel>
                                    <!-- Верхняя строка: ник + время -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding UserName}"
                                                   Foreground="#FFD700"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeDisplay}"
                                                   Foreground="#666680"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Стикер -->
                                    <Image Source="{Binding FilePath}"
                                           MaxHeight="200"
                                           MaxWidth="200"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding IsSticker, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Видео -->
                                    <MediaElement Source="{Binding FilePath}"
                                                  MaxHeight="200"
                                                  LoadedBehavior="Manual"
                                                  UnloadedBehavior="Manual"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,6,0,0"
                                                  Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Текст -->
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="#B0B0C0"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <!-- ✅ Анимация всегда срабатывает при появлении нового медиа -->
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                        From="0,10,0,-250"
                                                        To="0,0,0,0"
                                                        Duration="0:0:1.0">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопка "Вниз" -->
        <Button x:Name="ScrollToBottomButton"
                Width="40"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Command="{Binding ScrollToBottomCommand}"
                Visibility="Collapsed"
                Cursor="Hand"
                ToolTip="Прокрутить к последнему медиа">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#9147ff"
                            CornerRadius="20"
                            BorderThickness="0">
                        <TextBlock Text="↓"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>