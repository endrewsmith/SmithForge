<Window x:Class="SmithForge.Features.ImportantOverlay.ImportantOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmithForge.Features.ChatOverlay"
        Title="Important Overlay"
        Height="300" Width="450"
        MinHeight="100" MinWidth="100"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        ResizeMode="CanResize"
      
       
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:RankToColorConverter x:Key="RankToColorConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Контейнер для сообщений -->
        <ItemsControl x:Name="ImportantList" 
                      ItemsSource="{Binding DisplayMessages}" 
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False"
                      Margin="5">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Анимация выезжания снизу -->
                    <Grid x:Name="MsgContainer" 
                          Opacity="0"
                          RenderTransformOrigin="0.5,1"
                          Margin="0,5,0,0">

                        <Grid.RenderTransform>
                            <TranslateTransform Y="50"/>
                        </Grid.RenderTransform>

                        <ContentControl Content="{Binding}" 
                                        ContentTemplate="{Binding MessageSkin}"/>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Выезжание снизу -->
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                         From="50" To="0" 
                                                         Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <!-- Плавное проявление -->
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" 
                                                         Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Область перетаскивания -->
        <Border x:Name="DragArea" 
                Background="#44000000" 
                BorderBrush="Cyan" 
                BorderThickness="2"
                Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVis}}"
                Cursor="SizeAll">
            <TextBlock Text="[ ВАЖНЫЕ СООБЩЕНИЯ ]" 
                       Foreground="Cyan" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Opacity="0.5"/>
        </Border>
    </Grid>
</Window>