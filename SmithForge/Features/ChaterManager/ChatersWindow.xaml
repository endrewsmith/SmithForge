<Window x:Class="SmithForge.Features.ChaterManager.ChatersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.ChaterManager"
        x:Name="ThisWindow"
        mc:Ignorable="d"
        Title="Управление базой зрителей" Height="750" Width="1300"
        WindowStartupLocation="CenterOwner" Background="#F4F4F7">

    <Window.Resources>
        <local:RankToTextConverter x:Key="RankToTextConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== ЛЕВАЯ ЧАСТЬ: ПОИСК И ТАБЛИЦА ========== -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Блок поиска -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" 
                    BorderBrush="#E0E0E6" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" FontSize="16"/>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" 
                                 VerticalContentAlignment="Center" 
                                 FontSize="14"
                                 Background="Transparent"/>

                        <TextBlock IsHitTestVisible="False" 
                                   Text="Поиск по имени или платформе..." 
                                   VerticalAlignment="Center" 
                                   Margin="3,0,0,0" 
                                   Foreground="Gray"
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Кнопка создания нового аккаунта -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="0" Margin="0,0,0,15" 
                    BorderBrush="#E0E0E6" BorderThickness="1" Height="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="➕ Создать нового зрителя" 
                               VerticalAlignment="Center" 
                               Margin="15,0,0,0" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#5C6BC0"/>

                    <Button Grid.Column="1" 
                            Content="Создать" 
                            Command="{Binding CreateNewCommand}"
                            Background="#5C6BC0" 
                            Foreground="White" 
                            BorderThickness="0"
                            Height="35" 
                            Width="80" 
                            Margin="0,0,10,0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Таблица зрителей -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E0E0E6" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding FilteredChaters}" 
                          SelectedItem="{Binding SelectedChater, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutoGenerateColumns="False" CanUserAddRows="False" 
                          IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F5" RowHeight="60" BorderThickness="0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="60"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderBrush" Value="#5C6BC0"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- ID (скрытая колонка или видимая) -->
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="200"/>

                        <!-- ПЛАТФОРМЫ -->
                        <DataGridTemplateColumn Header="Платформы" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Accounts}" Margin="2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Background="{Binding PlatformColor}" 
                                                            Width="12" 
                                                            Height="12" 
                                                            CornerRadius="2" 
                                                            Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding PlatformShort}" 
                                                               FontWeight="Bold"
                                                               Foreground="{Binding PlatformColor}"
                                                               FontSize="11"
                                                               Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding DisplayId}" 
                                                               FontSize="11"
                                                               Foreground="#333"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ИМЯ В ЧАТЕ -->
                        <DataGridTextColumn Header="Имя в чате" Binding="{Binding EffectiveName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- КАРМАКЕЙ -->
                        <DataGridTextColumn Header="КармаКей" Binding="{Binding KarmaKeyDisplay, Mode=OneWay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#9C27B0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- РАНГ -->
                        <DataGridTemplateColumn Header="Ранг" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Rank, Converter={StaticResource RankToTextConverter}}" 
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rank}" Value="0">
                                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                                        <Setter Property="Foreground" Value="#CD7F32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rank}" Value="2">
                                                        <Setter Property="Foreground" Value="#C0C0C0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rank}" Value="3">
                                                        <Setter Property="Foreground" Value="#FFD700"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rank}" Value="4">
                                                        <Setter Property="Foreground" Value="#FF4500"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ВСЯ КАРМА -->
                        <DataGridTextColumn Header="Вся карма" Binding="{Binding TotalKarma, StringFormat=F1}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- КАРМА -->
                        <DataGridTextColumn Header="Карма" Binding="{Binding Karma, StringFormat=F1}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- СООБЩЕНИЯ -->
                        <DataGridTextColumn Header="Сообщ." Binding="{Binding MessageCount}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ========== РАЗДЕЛИТЕЛЬ ========== -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- ========== ПРАВАЯ ЧАСТЬ: КАРТОЧКА ========== -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" 
                BorderBrush="#E0E0E6" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Заголовок -->
                    <TextBlock Text="Карточка зрителя" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2D2D30"/>

                    <!-- ВСЕ ПОЛЯ КАРТОЧКИ -->
                    <StackPanel DataContext="{Binding SelectedChater}">

                        <!-- ИМЯ ПОЛЬЗОВАТЕЛЯ -->
                        <TextBlock Text="ИМЯ ПОЛЬЗОВАТЕЛЯ" FontSize="10" FontWeight="Bold" Foreground="#5C6BC0" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                 Margin="0,0,0,15" 
                                 FontSize="18" 
                                 Padding="5" 
                                 FontWeight="Bold"
                                 Background="#FFF9C4"/>

                        <!-- ID ПОЛЬЗОВАТЕЛЯ (для копирования) -->
                        <TextBlock Text="ID ПОЛЬЗОВАТЕЛЯ" FontSize="10" FontWeight="Bold" Foreground="#9E9EAE" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Id}" 
                                 IsReadOnly="True" 
                                 Background="#F5F5F5" 
                                 Margin="0,0,0,15" 
                                 Padding="5" 
                                 FontSize="11"
                                 FontFamily="Consolas"/>

                        <!-- КармаКей -->
                        <TextBlock Text="КАРМАКЕЙ" FontSize="10" FontWeight="Bold" Foreground="#9E9EAE" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding KarmaKeyDisplay, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Background="#F5F5F5" 
                                     Padding="5" 
                                     FontWeight="Bold"/>
                            <CheckBox Grid.Column="1" 
                                      Content="Постоянный" 
                                      IsChecked="{Binding IsKarmaKeyPermanent}" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0"/>
                        </Grid>

                        <!-- СВЯЗАННЫЕ АККАУНТЫ -->
                        <TextBlock Text="СВЯЗАННЫЕ АККАУНТЫ" FontSize="12" FontWeight="Bold" Foreground="#2D2D30" Margin="0,5,0,10"/>

                        <!-- Список аккаунтов -->
                        <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F8FA" CornerRadius="6" Padding="8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                    Background="{Binding PlatformColor}" 
                                                    Width="16" 
                                                    Height="16" 
                                                    CornerRadius="3" 
                                                    Margin="0,0,8,0"/>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding PlatformShort}" 
                                                       FontWeight="Bold"
                                                       Foreground="{Binding PlatformColor}"
                                                       FontSize="12"
                                                       Margin="0,0,4,0"/>

                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding ExternalId}" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#333"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="3" 
                                                    Content="✖" 
                                                    Width="20" Height="20"
                                                    Background="#FFEBEE"
                                                    Foreground="#D32F2F"
                                                    BorderThickness="0"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Отвязать аккаунт"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Блок добавления аккаунта -->
                        <Border Background="#F0F4FF" CornerRadius="4" Padding="8" Margin="0,5,0,15">
                            <StackPanel>
                                <TextBlock Text="Добавить новый аккаунт" FontSize="11" FontWeight="Bold" Foreground="#5C6BC0" Margin="0,0,0,5"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" 
                                              ItemsSource="{Binding DataContext.AvailablePlatforms, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DataContext.NewAccountPlatform, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,0,5,0" Height="30"/>

                                    <TextBox Grid.Column="1" 
                                             Text="{Binding DataContext.NewAccountLogin, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,5,0" Height="30"/>

                                    <Button Grid.Column="2" 
                                            Content="➕" 
                                            Width="30" Height="30"
                                            Background="#5C6BC0"
                                            Foreground="White"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.AddAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Привязать аккаунт"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Карма -->
                        <UniformGrid Columns="2" Margin="0,0,0,15">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Карма" FontSize="10" FontWeight="Bold" Foreground="#9E9EAE" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Karma, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" 
                                         Foreground="#2E7D32" FontWeight="Bold" Padding="5"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="Вся карма" FontSize="10" FontWeight="Bold" Foreground="#9E9EAE" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding TotalKarma, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" 
                                         Foreground="#1565C0" FontWeight="Bold" Padding="5"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Ранг и множитель -->
                        <UniformGrid Columns="2" Margin="0,0,0,15">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="РАНГ" FontSize="10" FontWeight="Bold" Foreground="#9E9EAE" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="35"
                                         Padding="5"
                                         FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="МНОЖИТЕЛЬ" FontSize="10" FontWeight="Bold" Foreground="#9E9EAE" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding KarmaMultiplier, Mode=OneWay, StringFormat='x{0:N1}'}" 
                                         IsReadOnly="True" 
                                         Background="#F5F5F5" 
                                         Padding="5" 
                                         FontWeight="Bold"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Сообщения -->
                        <TextBlock Text="ВСЕГО СООБЩЕНИЙ" FontSize="10" FontWeight="Bold" Foreground="#9E9EAE" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MessageCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,25" Padding="5"/>

                    </StackPanel>

                    <!-- Секция объединения аккаунтов -->
                    <Border Background="#F0F0F5" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="ОБЪЕДИНЕНИЕ АККАУНТОВ" FontSize="11" FontWeight="Bold" Foreground="#5C6BC0" Margin="0,0,0,8"/>

                            <TextBlock Text="ID аккаунта-донора:" FontSize="10" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding MergeDonorId, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,5" Padding="5" Height="25"/>

                            <Button Content="Поглотить" 
                                    Command="{Binding MergeCommand}"
                                    Background="#FF5722" 
                                    Foreground="White"
                                    Height="30"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <TextBlock Text="* Все аккаунты и статистика донора будут перенесены, сам донор удалён. Имя поглотителя сохраняется." 
                                       FontSize="8" Foreground="#999" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- КНОПКИ -->
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="СОХРАНИТЬ ИЗМЕНЕНИЯ" 
                                Command="{Binding SaveChaterCommand}"
                                CommandParameter="{Binding SelectedChater}"
                                Foreground="White" Height="45" FontWeight="Bold"
                                Background="#5C6BC0"
                                Margin="0,0,10,0"/>

                        <!-- Галочка сохранения -->
                        <Border Grid.Column="1" 
                                Width="45" Height="45"
                                CornerRadius="6"
                                Background="#4CAF50"
                                Visibility="{Binding SelectedChater.IsRecentlySaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✓" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Кнопка удаления -->
                    <Button Content="Удалить профиль полностью" 
                            Command="{Binding DeleteChaterCommand}"
                            Foreground="#D32F2F" 
                            Height="35" 
                            FontWeight="SemiBold" 
                            Margin="0,5,0,0"
                            Background="Transparent" 
                            BorderBrush="#FFEBEE" 
                            BorderThickness="1"
                            Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>