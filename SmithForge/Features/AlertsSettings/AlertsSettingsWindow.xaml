<Window x:Class="SmithForge.Features.AlertsSettings.AlertsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmithForge.Features.AlertsSettings"
        Title="Настройки алертов"
        Height="620" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#1E1E2E">

    <Window.DataContext>
        <local:AlertsSettingsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3D3D4E"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D3E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3D3D4E"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3D3D4E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#5D5D6E"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК -->
        <TextBlock Grid.Row="0"
                   Text="🔔 Настройки алертов"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FFD700"
                   Margin="0,0,0,15"/>

        <!-- ВКЛАДКИ -->
        <TabControl Grid.Row="1"
                    Background="#252535"
                    BorderBrush="#3D3D4E">

            <!-- ============================================================ -->
            <!-- ВКЛАДКА: ОБЩИЕ -->
            <!-- ============================================================ -->
            <TabItem Header="⚙️ Общие">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Общие настройки оверлея алертов"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFD700"
                                   Margin="0,0,0,15"/>

                        <CheckBox Content="Показывать окно оверлея"
                                  IsChecked="{Binding AlertsOverlayVisible}"/>

                        <TextBlock Text="Длительность показа одного алерта (секунды):"
                                   Margin="0,15,0,5"/>

                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding AlertsAlertDuration}"
                                    Minimum="3"
                                    Maximum="60"
                                    Width="300"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AlertsAlertDuration}"
                                       Margin="15,0,0,0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FFD700"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="сек."
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- ВКЛАДКА: DONATIONALERTS (OAuth) -->
            <!-- ============================================================ -->
            <TabItem Header="💛 DonationAlerts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="DonationAlerts (OAuth)"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFD700"
                                   Margin="0,0,0,15"/>

                        <CheckBox Content="Включить алерты DonationAlerts"
                                  IsChecked="{Binding DonationAlertsEnabled}"/>

                        <!-- Инструкция -->
                        <Border Background="#252535"
                                BorderBrush="#3D3D4E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,15,0,10">
                            <StackPanel>
                                <TextBlock Text="💡 Шаг 1. Зарегистрируйте приложение:"
                                           FontWeight="Bold"
                                           Foreground="#FFD700"
                                           Margin="0,0,0,5"/>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#BBB"
                                           FontSize="12"
                                           Margin="0,0,0,10">
                                    Перейдите на сайт DonationAlerts → раздел OAuth-приложения.<LineBreak/>
                                    Создайте приложение с Redirect URI:<LineBreak/>
                                    <Run Text="http://localhost:17845/" Foreground="#FFD700" FontWeight="Bold"/><LineBreak/>
                                    Скопируйте App ID и API Key.
                                </TextBlock>

                                <Button Content="🌐 Открыть DonationAlerts"
                                        Command="{Binding OpenDonationAlertsPageCommand}"
                                        HorizontalAlignment="Left"
                                        Background="#FFD700"
                                        Foreground="#1E1E2E"
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Шаг 2: Ввод ключей -->
                        <TextBlock Text="💡 Шаг 2. Вставьте ключи приложения:"
                                   FontWeight="Bold"
                                   Foreground="#FFD700"
                                   Margin="0,10,0,5"/>

                        <TextBlock Text="App ID (Client ID):"
                                   Margin="0,10,0,5"/>
                        <TextBox Text="{Binding DonationAlertsClientId, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding DonationAlertsEnabled}"/>

                        <TextBlock Text="API Key (Client Secret):"
                                   Margin="0,5,0,5"/>
                        <PasswordBox x:Name="ClientSecretBox"
                                     PasswordChanged="ClientSecretBox_PasswordChanged"
                                     IsEnabled="{Binding DonationAlertsEnabled}"/>

                        <!-- Шаг 3: Авторизация -->
                        <Border Background="#252535"
                                BorderBrush="#3D3D4E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,15,0,10">
                            <StackPanel>
                                <TextBlock Text="💡 Шаг 3. Авторизация:"
                                           FontWeight="Bold"
                                           Foreground="#FFD700"
                                           Margin="0,0,0,8"/>

                                <Button Content="🔑 Войти через DonationAlerts"
                                        Command="{Binding AuthorizeCommand}"
                                        IsEnabled="{Binding DonationAlertsEnabled}"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Left"
                                        Padding="15,8"/>

                                <!-- Статус авторизации -->
                                <TextBlock Text="{Binding DonationAlertsAuthStatus}"
                                           Margin="0,10,0,0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DonationAlertsIsAuthorized}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- ВКЛАДКА: DONATEPAY -->
            <!-- ============================================================ -->
            <TabItem Header="💙 DonatePay">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="DonatePay"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#00BFFF"
                                   Margin="0,0,0,15"/>

                        <CheckBox Content="Включить алерты DonatePay"
                                  IsChecked="{Binding DonationPayEnabled}"/>

                        <Border Background="#252535"
                                BorderBrush="#3D3D4E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,15,0,10">
                            <StackPanel>
                                <TextBlock Text="💡 Как получить API-ключ:"
                                           FontWeight="Bold"
                                           Foreground="#00BFFF"
                                           Margin="0,0,0,5"/>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#BBB"
                                           FontSize="12"
                                           Margin="0,0,0,10">
                                    1. Зайдите на donatepay.ru<LineBreak/>
                                    2. Профиль → API<LineBreak/>
                                    3. Скопируйте API-ключ и вставьте ниже<LineBreak/>
                                    4. User ID определится автоматически
                                </TextBlock>

                                <Button Content="🌐 Открыть donatepay.ru"
                                        Command="{Binding OpenDonationPayPageCommand}"
                                        HorizontalAlignment="Left"
                                        Background="#00BFFF"
                                        Foreground="#1E1E2E"
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="API-ключ:"
                                   Margin="0,10,0,5"/>
                        <PasswordBox x:Name="DonatePayApiKeyBox"
                                     PasswordChanged="DonatePayApiKeyBox_PasswordChanged"
                                     IsEnabled="{Binding DonationPayEnabled}"/>

                        <!-- Статус -->
                        <TextBlock Text="{Binding DonationPayAuthStatus}"
                                   Margin="0,15,0,0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#F44336"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DonationPayIsAuthorized}" Value="True">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- КНОПКИ ВНИЗУ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="💾 Сохранить"
                    Command="{Binding SaveCommand}"
                    Background="#4CAF50"
                    BorderBrush="#66BB6A"
                    MinWidth="120"/>
            <Button Content="❌ Отмена"
                    Command="{Binding CancelCommand}"
                    MinWidth="120"
                    Margin="0"/>
        </StackPanel>
    </Grid>
</Window>