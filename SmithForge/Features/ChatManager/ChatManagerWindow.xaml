<Window x:Class="SmithForge.Features.ChatManager.ChatManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.ChatManager"
        xmlns:converters="clr-namespace:SmithForge.Main.Converters"
        mc:Ignorable="d"
        Title="Управление чатами" Height="550" Width="850"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:PlatformToVisibilityConverter x:Key="PlatformToVisibilityConverter"/>
        <converters:YouTubeMethodToVisibilityConverter x:Key="YouTubeMethodToVisibilityConverter"/>
        <converters:YouTubeMethodNotToVisibilityConverter x:Key="YouTubeMethodNotToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Управление чатами" FontSize="20" FontWeight="Bold"/>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="💾 Сохранить все" 
                    Command="{Binding SaveAllCommand}"
                    Padding="10,5"
                    Margin="0,0,10,0"/>
            
            <Button Content="➕ Добавить чат" 
                    Command="{Binding AddChatCommand}"
                    Padding="10,5"/>
        </StackPanel>

        <!-- Список чатов -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
                <ItemsControl ItemsSource="{Binding Chats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#444" BorderThickness="1" CornerRadius="5" Margin="0,2" Padding="5" Background="#2D2D30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                    <!-- Иконка платформы -->
                                    <TextBlock Grid.Column="0" Text="{Binding PlatformIcon}" FontSize="20" Margin="5,0"/>

                                    <!-- Информация о чате -->
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="{Binding ChatName}" FontWeight="Bold" Foreground="White"/>

                                        <!-- СТАТУС С ЦВЕТНЫМ ИНДИКАТОРОМ -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Width="8" Height="8" CornerRadius="4" 
                                                    Background="{Binding StatusColor}" 
                                                    Margin="0,0,5,0" 
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ShortStatus}" 
                                                       FontSize="12" 
                                                       Foreground="{Binding StatusColor}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding ModeDisplay}" FontSize="10" Foreground="Gray"/>
                                        <!-- Метод подключения (для YouTube) -->
                                        <TextBlock Text="{Binding MethodDisplay}" FontSize="9" Foreground="#888"
                                                   Margin="0,1,0,0"
                                                   Visibility="{Binding IsYouTube, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Поле для Video ID + кнопка (только для YouTube) -->
                                        <Grid Margin="0,3,0,0"
                                              Visibility="{Binding IsYouTube, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" 
                                                     Text="{Binding VideoId, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="130"
                                                     Padding="5"
                                                     VerticalAlignment="Center"
                                                     Background="#2D2D30"
                                                     Foreground="White"
                                                     BorderBrush="#555"
                                                     BorderThickness="1"
                                                     ToolTip="Введите Video ID (11 символов)"/>
                                            <Button Grid.Column="1" 
                                                    Content="▶"
                                                    Width="28"
                                                    Height="24"
                                                    Margin="5,0,0,0"
                                                    Padding="0"
                                                    Background="#4CAF50"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Подключиться по этому Video ID"
                                                    Command="{Binding DataContext.ConnectByVideoIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="3"
                                                                BorderThickness="0">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#45a049"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Счетчик сообщений -->
                                    <TextBlock Grid.Column="2" Text="{Binding MessageCount}" Margin="10,0" Foreground="Gray"/>

                                <!-- Кнопка Connect/Disconnect -->
                                <Button Grid.Column="3" 
        Margin="5,0"
        Padding="8,3"
        Tag="{Binding}"
        Click="OnConnectButtonClick">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="🔌 Подключить"/>
                                            <Setter Property="Background" Value="#4CAF50"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Content" Value="⏹ Отключить"/>
                                                    <Setter Property="Background" Value="#FF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Кнопка изменения метода (только для YouTube) -->
                                    <Button Grid.Column="4" 
                                            Content="⚙️"
                                            Command="{Binding DataContext.ChangeMethodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="5,0"
                                            Padding="5,3"
                                            Visibility="{Binding Platform, Converter={StaticResource PlatformToVisibilityConverter}, ConverterParameter='youtube'}"/>

                                    <!-- Кнопка удаления -->
                                    <Button Grid.Column="5" 
                                            Content="🗑️"
                                            Command="{Binding DataContext.RemoveChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="5,0"
                                            Padding="5,3"
                                            Background="#FF6B6B"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </ScrollViewer>

        <!-- Форма добавления чата -->
        <Border Grid.Row="3" 
                Background="#2D2D30" 
                CornerRadius="8" 
                Padding="15"
                Visibility="{Binding IsAddingChat, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                           Text="➕ Добавление чата" 
                           FontSize="16" FontWeight="Bold" 
                           Margin="0,0,0,10"/>

                <!-- Платформа -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Платформа:" VerticalAlignment="Center" Foreground="White"/>
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          ItemsSource="{Binding AvailablePlatforms}"
                          SelectedValue="{Binding SelectedPlatform}"
                          SelectedValuePath="Value"
                          Margin="0,0,0,5">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Режим -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Режим:" VerticalAlignment="Center" Foreground="White"/>
                <ComboBox Grid.Row="2" Grid.Column="1" 
                          ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding SelectedMode}"
                          Margin="0,0,0,5"/>

                <!-- Название чата -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Foreground="White"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ChatName}" 
                         Margin="0,0,0,5" 
                         ToolTip="Введите понятное название для чата"
                         FontWeight="SemiBold"/>

                <!-- ============ YouTube ============ -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
                            Visibility="{Binding SelectedPlatform, Converter={StaticResource PlatformToVisibilityConverter}, ConverterParameter='youtube'}">

                    <!-- Метод подключения -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Метод:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding YouTubeMethods}"
                                  SelectedItem="{Binding SelectedYouTubeMethodItem}"
                                  DisplayMemberPath="DisplayName"/>
                    </Grid>

                    <!-- Описание метода -->
                    <TextBlock Text="{Binding SelectedYouTubeMethodItem.Description}" 
                               FontSize="11" Foreground="Gray" 
                               Margin="0,0,0,5" TextWrapping="Wrap"/>

                    <!-- API Key -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Foreground="White"/>
                        <PasswordBox Grid.Column="1" x:Name="YouTubeApiKeyBox" 
                                      PasswordChanged="YouTubeApiKeyBox_PasswordChanged"/>
                    </Grid>

                    <!-- Channel ID -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Channel ID:" VerticalAlignment="Center" Foreground="White"/>
                        <TextBox Grid.Column="1" Text="{Binding YouTubeChannelId}"/>
                    </Grid>
                </StackPanel>

                <!-- ============ Twitch ============ -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
            Visibility="{Binding SelectedPlatform, Converter={StaticResource PlatformToVisibilityConverter}, ConverterParameter='twitch'}">

                    <TextBlock Text="Для подключения к Twitch чату достаточно указать имя канала." 
               FontSize="11" Foreground="#888" 
               Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Имя канала:" VerticalAlignment="Center" Foreground="White"/>
                        <TextBox Grid.Column="1" Text="{Binding TwitchChannelName}" 
                 ToolTip="Введите имя канала Twitch (например: forsen, xqc)"/>
                    </Grid>
                </StackPanel>

                <!-- ============ GoodGame ============ -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
                            Visibility="{Binding SelectedPlatform, Converter={StaticResource PlatformToVisibilityConverter}, ConverterParameter='goodgame'}">

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ID канала:" VerticalAlignment="Center" Foreground="White"/>
                        <TextBox Grid.Column="1" Text="{Binding GoodGameChannelId}"/>
                    </Grid>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,15,0,0">

                    <Button Content="❌ Отмена" 
                            Command="{Binding CancelAddChatCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5"/>

                    <Button Content="✅ Добавить" 
                            Command="{Binding SaveChatCommand}"
                            Padding="15,5"
                            Background="#4CAF50"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>