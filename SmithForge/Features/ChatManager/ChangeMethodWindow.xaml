<Window x:Class="SmithForge.Features.ChatManager.ChangeMethodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SmithForge.Main.Converters"
        Title="Смена метода подключения YouTube"
        Width="500" 
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Window.Resources>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A3A"/>
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Редактирование чата" 
                   FontSize="15" 
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,15"/>

        <!-- Название чата -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Название:" VerticalAlignment="Center" Foreground="#CCC"/>
            <TextBox Grid.Column="1" Text="{Binding ChatName, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" 
                     Foreground="White" Padding="5"/>
        </Grid>

        <!-- Режим (Normal/Shorts) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Режим:" VerticalAlignment="Center" Foreground="#CCC"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="📺 Normal" IsChecked="{Binding IsNormalSelected, Mode=OneWay}" 
                             GroupName="Mode" Margin="0,0,15,0"/>
                <RadioButton Content="📱 Shorts" IsChecked="{Binding IsShortsSelected}" 
                             GroupName="Mode"/>
            </StackPanel>
        </Grid>

        <!-- Тип подключения -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Тип:" VerticalAlignment="Center" Foreground="#CCC"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="🔑 API" IsChecked="{Binding IsApiOnlySelected, Mode=OneWay}" 
                             GroupName="Method" Margin="0,0,15,0"/>
                <RadioButton Content="🌐 Парсинг" IsChecked="{Binding IsHtmlOnlySelected}" 
                             GroupName="Method"/>
            </StackPanel>
        </Grid>

        <!-- Список методов -->
        <ListBox Grid.Row="4" 
                 ItemsSource="{Binding Methods}"
                 SelectedItem="{Binding SelectedMethod}"
                 Background="#1E1E1E"
                 BorderBrush="#444"
                 BorderThickness="1"
                 Height="100"
                 Margin="0,0,0,10"
                 Visibility="Collapsed">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding Description}" 
                                   FontSize="11" 
                                   Foreground="#888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Video ID -->
        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Video ID:" VerticalAlignment="Center" Foreground="#CCC"/>
            <TextBox Grid.Column="1" Text="{Binding Chat.VideoId, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" 
                     Foreground="White" Padding="5"/>
            <TextBlock Grid.Column="1" Text="Введите Video ID (11 символов) для подключения к конкретному видео" 
                       FontSize="10" Foreground="#888" Margin="0,23,0,0"/>
        </Grid>

        <!-- Channel ID -->
        <Grid Grid.Row="6" Margin="0,0,0,15" Visibility="{Binding Chat.IsYouTube, Source={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Channel ID:" VerticalAlignment="Center" Foreground="#CCC"/>
            <TextBox Grid.Column="1" Text="{Binding Chat.ChannelId, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" 
                     Foreground="White" Padding="5"/>
            <TextBlock Grid.Column="1" Text="ID YouTube канала (например: UCxxxxxxxxxxxxxxxxxxxx)" 
                       FontSize="10" Foreground="#888" Margin="0,23,0,0"/>
        </Grid>

        <!-- API Key -->
        <Grid Grid.Row="7" Margin="0,0,0,15" Visibility="{Binding Chat.IsYouTube, Source={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Foreground="#CCC"/>
            <TextBox Grid.Column="1" Text="{Binding Chat.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E1E1E" BorderBrush="#555" BorderThickness="1" 
                     Foreground="White" Padding="5"/>
            <TextBlock Grid.Column="1" Text="YouTube Data API v3 ключ для подключения через API" 
                       FontSize="10" Foreground="#888" Margin="0,23,0,0"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Click="CancelButton_Click"
                    Width="80" 
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#444"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="💾 Применить" 
                    Click="SaveButton_Click"
                    Width="100" 
                    Height="35"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>