<Window x:Class="SmithForge.Features.TechOverlay.TechOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.TechOverlay"
        mc:Ignorable="d"
        Title="Tech Overlay — контроль событий"
        Height="500" Width="420"
        Background="#1E1E2E"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track"
                                   Grid.Row="1"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#555555"
                                                        CornerRadius="4"
                                                        Height="40"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#252535" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🔧 Технические события"
                           Foreground="#CFCFE0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="🗑"
                        Click="ClearButton_Click"
                        Width="26" Height="26"
                        Background="Transparent"
                        Foreground="#CCC"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        ToolTip="Очистить события"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="EventsScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#1E1E2E"
                      Padding="0,0,0,0"
                      ScrollChanged="EventsScrollViewer_ScrollChanged">
            <ItemsControl x:Name="MessagesList"
                          ItemsSource="{Binding Events}"
                          IsHitTestVisible="True"
                          Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="EventGrid"
                              Background="Transparent">
                            <Border Background="#2A2A3A"
        BorderBrush="#3A3A5A"
        BorderThickness="0,0,0,1"
        Padding="10,6"
        Margin="0,4,0,4">
                                <StackPanel>

                                    <!-- Верхняя строка: иконка + имя + время справа -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}"
           FontSize="14"
           Foreground="#D4AF37"
           Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding UserName}"
                           Foreground="#FFD700"
                           FontWeight="SemiBold"
                           FontSize="12"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                       Text="{Binding TimeDisplay}"
                       Foreground="#666680"
                       FontSize="10"
                       VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Текст события -->
                                    <TextBlock Text="{Binding Text}"
                   Foreground="#B0B0C0"
                   FontSize="11"
                   Margin="20,2,0,0"
                   TextWrapping="Wrap"/>

                                    <!-- Нижняя строка: карма справа -->
                                    <TextBlock Text="{Binding KarmaDisplay}"
                   Foreground="#00FFFF"
                   FontSize="11"
                   FontWeight="Bold"
                   HorizontalAlignment="Right"
                   Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasKarma}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <!-- ✅ Анимация всегда срабатывает при появлении нового события -->
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                        From="0,10,0,-250"
                                                        To="0,0,0,0"
                                                        Duration="0:0:1.0">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопка "Вниз" -->
        <Button x:Name="ScrollToBottomButton"
                Grid.Row="1"
                Width="40" Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Click="ScrollToBottomButton_Click"
                Visibility="Collapsed"
                Cursor="Hand"
                ToolTip="Прокрутить к последнему событию">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#9147ff"
                            CornerRadius="20"
                            BorderThickness="0">
                        <TextBlock Text="↓"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>