<Window x:Class="SmithForge.Features.ChatOverlayShorts.ChatOverlayShortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmithForge.Features.ChatOverlay"
        xmlns:services="clr-namespace:SmithForge.Main.Services;assembly=SmithForge"
        Title="Shorts Overlay" Height="600" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- Сообщения -->
        <ItemsControl x:Name="MessagesList" 
                      ItemsSource="{Binding DisplayMessages}" 
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Добавляем контейнер с анимацией, но оставляем MessageSkin -->
                    <Grid x:Name="MsgContainer" 
              Opacity="{Binding Opacity, Mode=OneWay}">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleY="{Binding ScaleY, Mode=OneWay}"/>
                        </Grid.LayoutTransform>

                        <!-- Ваша существующая универсальная разметка -->
                        <ContentControl Content="{Binding}" 
                            ContentTemplate="{Binding MessageSkin}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Область перетаскивания -->
        <Border x:Name="DragArea" 
                Background="#44000000" 
                BorderBrush="Cyan" 
                BorderThickness="2"
                Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVis}}"
                Cursor="SizeAll">
            <TextBlock Text="[ SHORTS CHAT ]" 
                       Foreground="Cyan" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Opacity="0.5"/>
        </Border>
    </Grid>
</Window>