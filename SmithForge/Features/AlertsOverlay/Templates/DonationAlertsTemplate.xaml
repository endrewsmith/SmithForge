<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SmithForge.Features.AlertsOverlay">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <DataTemplate x:Key="DonationAlertsTemplate" DataType="{x:Type local:AlertDisplayModel}">
        <Border Background="#E60D0D1A"
                CornerRadius="20"
                BorderBrush="#FFD700"
                BorderThickness="2"
                Padding="25,15">
            <Border.Effect>
                <DropShadowEffect Color="#FFD700" BlurRadius="25" ShadowDepth="0" Opacity="0.7"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Заголовок с провайдером -->
                <TextBlock Text="💛 DonationAlerts"
                           FontSize="12"
                           Foreground="#FFD700"
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           Margin="0,0,0,5"/>

                <!-- Ник + сумма -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UserName}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FFD700"/>

                    <!-- ✅ Иконка "комиссия покрыта" -->
                    <TextBlock Text=" 💎"
                               FontSize="20"
                               ToolTip="Комиссия покрыта зрителем"
                               VerticalAlignment="Top"
                               Margin="5,0,0,0"
                               Visibility="{Binding IsCommissionCovered, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="  •  "
                               FontSize="28"
                               Foreground="#888"/>
                    <TextBlock Text="{Binding DisplayAmount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                </StackPanel>

                <!-- Сообщение -->
                <TextBlock Text="{Binding Message}"
                           FontSize="16"
                           Foreground="#DDDDDD"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="440"
                           Margin="0,10,0,0"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>

            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>