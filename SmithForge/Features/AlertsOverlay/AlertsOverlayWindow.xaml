<Window x:Class="SmithForge.Features.AlertsOverlay.AlertsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmithForge.Features.AlertsOverlay"
        Title="AlertsOverlay"
        Height="150" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <local:AlertsOverlayViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Templates/DonationAlertsTemplate.xaml"/>
                <ResourceDictionary Source="Templates/DonationPayTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Ресурсы -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <local:AlertTemplateSelector x:Key="AlertSelector"
                                     DonationAlertsTemplate="{StaticResource DonationAlertsTemplate}"
                                     DonationPayTemplate="{StaticResource DonationPayTemplate}"
                                     DefaultTemplate="{StaticResource DonationAlertsTemplate}"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Полоса для перетаскивания (только в setup-режиме) -->
        <Border x:Name="DragArea"
                Grid.Row="0"
                Background="#AAFFD700"
                Padding="8"
                Cursor="SizeAll"
                Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="🚧 Alerts Overlay — Setup Mode (перетащи за эту полосу) 🚧"
                       Foreground="Black"
                       FontWeight="Bold"
                       FontSize="12"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Область с алертом -->
        <Grid Grid.Row="1">
            <!-- Алерт -->
            <ContentControl Content="{Binding CurrentAlert}"
                            ContentTemplateSelector="{StaticResource AlertSelector}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>

            <!-- Placeholder в setup-режиме, когда алерта нет -->
            <TextBlock Text="⏳ Ожидание алерта..."
                       Foreground="#66FFD700"
                       FontSize="14"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSetupMode}" Value="True"/>
                                    <Condition Binding="{Binding CurrentAlert}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>