<Window x:Class="SmithForge.Features.ChatOverlay.ChatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmithForge.Features.ChatOverlay"
        Title="SmithForge Overlay" Height="600" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Добавляем префикс local: чтобы студия увидела твой класс -->
        <local:RankToColorConverter x:Key="RankToColorConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Сообщения -->
        <ItemsControl x:Name="MessagesList" 
                      ItemsSource="{Binding DisplayMessages}" 
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- ContentControl с анимацией появления -->
                    <ContentControl Content="{Binding}" 
                                    ContentTemplate="{Binding MessageSkin}">
                        <ContentControl.Resources>
                            <Storyboard x:Key="FadeInStoryboard">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                 From="0" To="1" Duration="0:0:0.4"/>
                            </Storyboard>
                        </ContentControl.Resources>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                            </EventTrigger>
                        </ContentControl.Triggers>
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Область перетаскивания -->
        <Border x:Name="DragArea" 
                Background="#44000000" 
                BorderBrush="Cyan" 
                BorderThickness="2"
                Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVis}}"
                Cursor="SizeAll">
            <TextBlock Text="[ ОБЛАСТЬ ЧАТА ]" 
                       Foreground="Cyan" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Opacity="0.5"/>
        </Border>
    </Grid>
</Window>