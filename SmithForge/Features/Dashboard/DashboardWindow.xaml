<Window x:Class="SmithForge.Features.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.Dashboard"
        xmlns:overlay="clr-namespace:SmithForge.Features.ChatOverlay"
        mc:Ignorable="d"
        Title="DashboardWindow" Height="600" Width="450"
        WindowStyle="None" AllowsTransparency="True" 
        Topmost="False" ShowInTaskbar="True"
        Visibility="Collapsed" ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <overlay:RankToColorConverter x:Key="RankToColorConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Верхняя полоса для перетаскивания -->
        <Border Height="30" VerticalAlignment="Top" Background="#333">
            <TextBlock Text="📊 DASHBOARD" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Основной контент с отступом сверху -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#1E1E1E"
                      Margin="0,30,0,0">

            <ItemsControl x:Name="MessagesList" 
                          ItemsSource="{Binding DisplayMessages}" 
                          VerticalAlignment="Bottom"
                          IsHitTestVisible="False"
                          Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" 
                                        ContentTemplate="{Binding MessageSkin}"
                                        Margin="0,2">
                            <ContentControl.Resources>
                                <Storyboard x:Key="FadeInStoryboard">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                     From="0" To="1" Duration="0:0:0.4"/>
                                </Storyboard>
                            </ContentControl.Resources>
                            <ContentControl.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                                </EventTrigger>
                            </ContentControl.Triggers>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Gripper для изменения размера (правый нижний угол) -->
        <Border Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#555" Opacity="0.5">
            <TextBlock Text="⬊" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>