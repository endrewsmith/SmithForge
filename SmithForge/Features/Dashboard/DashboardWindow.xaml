<Window x:Class="SmithForge.Features.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.Dashboard"
        xmlns:overlay="clr-namespace:SmithForge.Features.ChatOverlay"
        mc:Ignorable="d"
        Title="DashboardWindow" Height="600" Width="450"
        WindowStyle="None" AllowsTransparency="True" 
        Topmost="False" ShowInTaskbar="True"
        Visibility="Collapsed" ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <overlay:RankToColorConverter x:Key="RankToColorConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Верхняя полоса для перетаскивания -->
        <Border Height="30" VerticalAlignment="Top" Background="#333" 
                MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📊 DASHBOARD" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Кнопка закрытия -->
                <Button Grid.Column="1" 
                        Content="✕" 
                        Width="30" 
                        Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#999"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="Закрыть дашборд"
                        Margin="0,0,5,0"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#373737"
                      Margin="0,30,0,20"
                      VerticalContentAlignment="Bottom">

            <ItemsControl x:Name="MessagesList" 
                          ItemsSource="{Binding DisplayMessages}" 
                          IsHitTestVisible="False"
                          Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" 
                                        ContentTemplate="{Binding MessageSkin}"
                                        Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Gripper для изменения размера -->
        <Border Width="20" Height="20" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Background="#555" 
                Opacity="0.5">
            <TextBlock Text="⬊" Foreground="White" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>