<Window x:Class="SmithForge.Features.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.Dashboard"
        xmlns:overlay="clr-namespace:SmithForge.Features.ChatOverlay"
        mc:Ignorable="d"
        Title="DashboardWindow" Height="600" Width="450"
        WindowStyle="None" AllowsTransparency="True" 
        Topmost="False" ShowInTaskbar="True"
        Visibility="Collapsed" ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <overlay:RankToColorConverter x:Key="RankToColorConverter"/>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#9147ff"/>
                    <Setter Property="Background" Value="#3a3a3a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Верхняя панель с заголовком и кнопками управления -->
        <Border Height="55" VerticalAlignment="Top" Background="#333" 
                MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="📊 DASHBOARD" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Кнопка закрытия -->
                <Button Grid.Row="0" Grid.Column="1" 
                        Content="✕" 
                        Width="30" 
                        Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#999"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="Закрыть дашборд"
                        Margin="0,0,5,0"/>

                <!-- Панель кнопок управления -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="−"
                            Command="{Binding DecreaseFontSizeCommand}"
                            ToolTip="Уменьшить шрифт"/>

                    <TextBlock Text="A" 
                               Foreground="#CCC" 
                               FontSize="12" 
                               VerticalAlignment="Center"
                               Margin="5,0"/>

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="+"
                            Command="{Binding IncreaseFontSizeCommand}"
                            ToolTip="Увеличить шрифт"/>

                    <Rectangle Width="1" Height="20" Fill="#555" Margin="8,0"/>

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="🗑"
                            Command="{Binding ClearMessagesCommand}"
                            ToolTip="Очистить все сообщения"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Visible" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#373737"
                      Margin="0,55,0,0"
                      Padding="0,10,0,0"
                      ScrollChanged="MainScrollViewer_ScrollChanged">
            <ItemsControl x:Name="MessagesList" 
                          ItemsSource="{Binding DisplayMessages}" 
                          IsHitTestVisible="False"
                          Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" 
                                        ContentTemplate="{Binding MessageSkin}"
                                        Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопка "Вниз" -->
        <Button x:Name="ScrollToBottomButton"
                Width="40" 
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Command="{Binding ScrollToBottomCommand}"
                Visibility="Collapsed"
                Cursor="Hand"
                ToolTip="Прокрутить к последнему сообщению">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#9147ff" 
                            CornerRadius="20"
                            BorderThickness="0">
                        <TextBlock Text="↓" 
                                   Foreground="White" 
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Gripper -->
        <Border Width="10" Height="10" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Background="#555" 
                Opacity="0.5">
            <TextBlock Text="⬊" Foreground="White" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>