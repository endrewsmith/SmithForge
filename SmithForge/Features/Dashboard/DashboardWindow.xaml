<Window x:Class="SmithForge.Features.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Features.Dashboard"
        xmlns:overlay="clr-namespace:SmithForge.Features.ChatOverlay"
        mc:Ignorable="d"
        Title="📊 Dashboard"
        Height="600" 
        Width="450"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Topmost="False" 
        ShowInTaskbar="True"
        Visibility="Collapsed"
        ShowActivated="True"
        ResizeMode="CanResize"
        Background="#232323">

    <Window.Resources>
        <overlay:RankToColorConverter x:Key="RankToColorConverter"/>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#9147ff"/>
                    <Setter Property="Background" Value="#3a3a3a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для скроллбара -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track" 
                                   Grid.Row="1"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#555555" 
                                                        CornerRadius="4"
                                                        Height="40"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Верхняя панель с заголовком и кнопками управления -->
        <Border Height="45" VerticalAlignment="Top" Background="#333">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Column="0" 
                           Text="📊 DASHBOARD" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <!-- Панель кнопок управления -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="−"
                            Command="{Binding DecreaseFontSizeCommand}"
                            ToolTip="Уменьшить шрифт"/>

                    <TextBlock Text="A" 
                               Foreground="#CCC" 
                               FontSize="12" 
                               VerticalAlignment="Center"
                               Margin="5,0"/>

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="+"
                            Command="{Binding IncreaseFontSizeCommand}"
                            ToolTip="Увеличить шрифт"/>

                    <Rectangle Width="1" Height="20" Fill="#555" Margin="8,0"/>

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="🗑"
                            Command="{Binding ClearMessagesCommand}"
                            ToolTip="Очистить все сообщения"/>

                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="✕"
                            Command="{Binding CloseCommand}"
                            ToolTip="Закрыть дашборд"
                            Foreground="#FF6B6B"
                            Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Visible" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#232323"
                      Margin="0,45,0,0"
                      Padding="0,10,0,0"
                      ScrollChanged="MainScrollViewer_ScrollChanged">
            <ItemsControl x:Name="MessagesList" 
                          ItemsSource="{Binding DisplayMessages}" 
                          IsHitTestVisible="True"
                          Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" 
                                        ContentTemplate="{Binding DashboardMessageSkin}"
                                        Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопка "Вниз" -->
        <Button x:Name="ScrollToBottomButton"
                Width="40" 
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Command="{Binding ScrollToBottomCommand}"
                Visibility="Collapsed"
                Cursor="Hand"
                ToolTip="Прокрутить к последнему сообщению">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#9147ff" 
                            CornerRadius="20"
                            BorderThickness="0">
                        <TextBlock Text="↓" 
                                   Foreground="White" 
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>