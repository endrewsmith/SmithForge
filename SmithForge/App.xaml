<Application x:Class="SmithForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmithForge"
             xmlns:converters="clr-namespace:SmithForge.Main.Converters"
             StartupUri="Main/Views/MainWindow.xaml">

    <Application.Resources>
        <converters:UnixToDateTimeConverter x:Key="UnixConverter"/>
        <converters:FormattedTextWithEmojiConverter x:Key="FormattedTextWithEmojiConverter"/>
    </Application.Resources>
</Application>