<Window x:Class="SmithForge.Main.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Main.Views"
        xmlns:converters="clr-namespace:SmithForge.Main.Converters"
        mc:Ignorable="d"
        Title="SmithForge" Height="1900" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:StatusToIconConverter x:Key="StatusToIconConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <converters:PlaybackModeToColorConverter x:Key="PlaybackModeToColorConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:PlatformToVisibilityConverter x:Key="PlatformToVisibilityConverter"/>
        <converters:YouTubeMethodToVisibilityConverter x:Key="YouTubeMethodToVisibilityConverter"/>
        <converters:YouTubeMethodNotToVisibilityConverter x:Key="YouTubeMethodNotToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="AutoSwitchToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C0C0C0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#66BB6A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- МЕНЮ (Строка 0) -->
        <Menu Grid.Row="0" Background="White" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Header="База данных зрителей" Click="OpenChaters_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="👥"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="История стримов" Click="OpenStreams_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎬"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Дашборд (скрытый чат)" Click="ToggleDashboard_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📊"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Технические события" Click="ToggleTechOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔧"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Медиа-дашборд" Click="ToggleMediaDashboard_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Важные сообщения" Click="ToggleImportantOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="❗"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Стикеры" Click="ToggleStickersOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Платформы">
                <MenuItem Header="🟣 Twitch.tv" IsHitTestVisible="False" FontWeight="Bold" Foreground="#6441a5"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateTwitch, UpdateSourceTrigger=PropertyChanged, Delay=800, ConverterCulture='en-US'}" 
                                     Width="50" 
                                     HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"
                                     CommandManager.PreviewExecuted="TextBox_PreviewExecuted"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="🔴 YouTube" IsHitTestVisible="False" FontWeight="Bold" Foreground="#FF0000"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateYouTube, Delay=800, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="50" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="🔵 GoodGame.ru" IsHitTestVisible="False" FontWeight="Bold" Foreground="#007bff"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateGoodGame, Delay=800, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="50" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="💾 Применить и сохранить" Command="{Binding SaveSettingsCommand}" FontWeight="Bold"/>
            </MenuItem>
            <MenuItem Header="Shorts Overlay" Click="ToggleShortsOverlay_Click"/>
            <MenuItem Header="🔔 Алерты">
                <MenuItem Header="⚙️ Настройки алертов" Click="OpenAlertsSettings_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙️"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="👁 Показать/скрыть оверлей алертов" Click="ToggleAlertsOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="👁"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="🌐 Открыть веб-оверлей в браузере" Click="OpenAlertsWebOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🌐"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (Строка 1) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,5">
            <Button Content="СТАРТ" Command="{Binding StartCommand}" 
                    Background="LightBlue" Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="СТОП" Command="{Binding StopCommand}" 
                    Background="LightCoral" Width="100" Height="30"/>
            <CheckBox Content="Показать окна чатов" 
                      IsChecked="{Binding Overlays.IsOverlaySetupMode}" 
                      VerticalAlignment="Center" 
                      Margin="20,0,0,0"
                      FontSize="14" FontWeight="Bold"/>
            <CheckBox Content="Спрятать окна" 
                      IsChecked="{Binding Overlays.IsOverlayHidden}" 
                      VerticalAlignment="Center" 
                      Margin="20,0,0,0"
                      FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- ПОЛОСКА СТРИМА (Строка 2) -->
        <Border Grid.Row="2" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding Session.LastStreamNumber, StringFormat='Был номер: {0}', FallbackValue='Был номер: 0'}" 
                               FontSize="10" 
                               Foreground="#A1887F" 
                               FontWeight="Bold"
                               Margin="62,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="СТРИМ №" FontWeight="Bold" VerticalAlignment="Center" Foreground="#795548"/>
                        <TextBox Text="{Binding Session.CurrentSession.Number, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="100" Height="24" Margin="5,0,0,0" 
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 FontWeight="Bold" Foreground="#E65100"
                                 PreviewTextInput="IntegerValidationTextBox"
                                 CommandManager.PreviewExecuted="TextBox_PreviewExecuted"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="СЛЕДУЮЩИЙ" Command="{Binding Session.NextStreamCommand}" 
                        Background="LightGreen" Width="100" Height="24" Margin="10,0,20,0"
                        FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock Text="ТЕКУЩАЯ ТЕМА" FontSize="10" Foreground="#A1887F" FontWeight="Bold" Margin="5,0,0,2"/>
                    <TextBox Text="{Binding Session.CurrentSession.Title, UpdateSourceTrigger=PropertyChanged}" 
                             Width="400" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#F5F5FA" BorderBrush="#DDD" BorderThickness="0,1,0,1" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📡 Мои чаты" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>

                    <TextBlock Grid.Column="1" Text="{Binding ChatsManager.Chats.Count, StringFormat='Всего: {0}'}" 
                       FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <Button Grid.Column="2" Content="➕ Добавить чат" 
                    Click="OpenChatManager_Click"
                    Padding="10,5"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <ItemsControl ItemsSource="{Binding ChatsManager.Chats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="6,4" Background="#2D2D30">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                         Width="10" Height="10"
                         VerticalAlignment="Center"
                         Margin="2,0,8,0"
                         Fill="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                         ToolTip="{Binding Status}"/>

                                        <TextBlock Grid.Column="1"
                           Text="{Binding ChatName}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"/>

                                        <TextBox Grid.Column="2"
                         Text="{Binding VideoId, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         Height="22"
                         FontSize="11"
                         Padding="4,0"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#555"
                         BorderThickness="1"
                         Margin="0,0,4,0"
                         ToolTip="Video ID (11 символов)"
                         Visibility="{Binding IsYouTube, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <Button Grid.Column="3"
                        Content="▶"
                        Width="26"
                        Height="22"
                        FontSize="10"
                        Padding="0"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Подключиться по Video ID"
                        Command="{Binding DataContext.ChatsManager.ConnectByVideoIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding IsYouTube, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <Button Grid.Column="4"
                        Width="90"
                        Height="22"
                        FontSize="11"
                        Padding="0"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        BorderThickness="0"
                        Command="{Binding ConnectCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="Подключить"/>
                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Content" Value="Отключить"/>
                                                            <Setter Property="Background" Value="#FF6B6B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="5"
                        Content="⚙"
                        Width="24"
                        Height="22"
                        FontSize="11"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="#555"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Сменить метод подключения"
                        Command="{Binding DataContext.ChatsManager.ChangeMethodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding Platform, Converter={StaticResource PlatformToVisibilityConverter}, ConverterParameter='youtube'}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock FontSize="11" Foreground="Gray">
                <Run Text="Активных: "/>
                <Run Text="{Binding ChatsManager.ConnectedChatsCount}" FontWeight="Bold" Foreground="#4CAF50"/>
                <Run Text=" | Сообщений: "/>
                <Run Text="{Binding ChatsManager.TotalMessagesCount}" FontWeight="Bold" Foreground="#2196F3"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- СТАТУС-БАР (Строка 4) -->
        <StatusBar Grid.Row="4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="Юзеров в базе: "/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding Users.Count}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding YouTube.Status}" Margin="20,0,0,0" Foreground="Gray"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Карма всем:" 
               VerticalAlignment="Center" 
               Margin="0,0,6,0"/>
                    <TextBox Text="{Binding KarmaAmountText, UpdateSourceTrigger=PropertyChanged}"
             Width="60"
             VerticalContentAlignment="Center"
             Margin="0,0,6,0"
             PreviewTextInput="IntegerValidationTextBox"
             CommandManager.PreviewExecuted="TextBox_PreviewExecuted"/>
                    <Button Content="Начислить"
            Command="{Binding AddKarmaToAllCommand}"
            ToolTip="Начислить указанное количество кармы всем зрителям"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- СЕКЦИЯ УПРАВЛЕНИЯ ОКНАМИ ЧАТОВ (Строка 7) -->
        <Border Grid.Row="5" Background="#F0F0F5" BorderBrush="#DDD" BorderThickness="0,1" Padding="10" Margin="0,5,0,0">
            <StackPanel>
                <TextBlock Text="УПРАВЛЕНИЕ ОКНАМИ ЧАТОВ" FontSize="12" FontWeight="Bold" Foreground="#5C6BC0" Margin="0,0,0,8"/>

                
                
                <!-- Инфо-чат: скорости -->
                <Border Grid.Row="8" Background="#F0F4FF" BorderBrush="#BBDEFB" BorderThickness="0,1,0,1" Padding="10" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="📚 Инфо-чат (витрина)" FontSize="14" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🏃 Скорость скролла:" VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <Slider Grid.Column="1" 
                    Minimum="200" 
                    Maximum="2000" 
                    Value="{Binding AudioSettings.ScrollSpeed, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="100" 
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" 
                       Text="{Binding AudioSettings.ScrollSpeed, StringFormat={}{0}мс}" 
                       Width="60" 
                       TextAlignment="Right" 
                       VerticalAlignment="Center" 
                       Margin="10,0,0,0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="✨ Скорость появления:" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Slider Grid.Column="1" 
            Minimum="0.1" 
            Maximum="2.0" 
            Value="{Binding AudioSettings.AppearSpeed, UpdateSourceTrigger=PropertyChanged}"
            TickFrequency="0.1" 
            IsSnapToTickEnabled="True"
            VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" 
               Text="{Binding AudioSettings.AppearSpeed, StringFormat={}{0:F1}с}" 
               Width="40" 
               TextAlignment="Right" 
               VerticalAlignment="Center" 
               Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ротация инфо-страниц -->
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📚 Инфо-чат (витрина)" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoRotation.Status}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding InfoRotation.TotalPages, StringFormat='📄 Страниц: {0}'}" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="▶️ Запустить" Command="{Binding InfoRotation.StartCommand}" 
                    Background="#4CAF50" Foreground="White" Padding="12,5" Margin="0,0,5,0"/>
                        <Button Content="⏹ Остановить" Command="{Binding InfoRotation.StopCommand}" 
                    Background="#F44336" Foreground="White" Padding="12,5" Margin="0,0,5,0"/>
                        <Button Content="🔄 Обновить список" Command="{Binding InfoRotation.RefreshPagesCommand}" 
                    Background="#2196F3" Foreground="White" Padding="12,5"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⏱ Тишина (сек):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" Minimum="5" Maximum="120" 
                    Value="{Binding InfoRotation.SilenceInterval, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="5" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding InfoRotation.SilenceInterval, StringFormat={}{0}с}" 
                       Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📊 Прогресс:" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <ProgressBar Grid.Column="1" 
                 Minimum="0" 
                 Maximum="{Binding InfoRotation.TotalPages}"
                 Value="{Binding InfoRotation.ShownPages}"
                 Height="10"
                 VerticalAlignment="Center"
                 Background="#2D2D44"
                 Foreground="#4CAF50"/>

                        <TextBlock Grid.Column="2" 
               Text="{Binding InfoRotation.ShownPages}" 
               FontSize="11"
               Foreground="#888"
               VerticalAlignment="Center" 
               Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Кнопки генерации страниц стикеров/звуков -->
                <Border Grid.Row="8" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="0,1,0,1" Padding="10" Margin="0,5,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🎨 Стикеры" FontSize="14" FontWeight="Bold" Foreground="#E65100"/>

                            <Button Grid.Column="2" Content="🔄 Сгенерировать страницы стикеров" 
                    Command="{Binding Stickers.GenerateStickerPagesCommand}"
                    Background="#4CAF50" Foreground="White" Padding="12,5"/>
                            <Button Grid.Column="3" Content="🔊 Сгенерировать страницы звуков" 
                    Command="{Binding Stickers.GenerateSoundPagesCommand}"
                    Background="#2196F3" Foreground="White" Padding="12,5"/>
                        </Grid>

                        <TextBlock Grid.Column="0" Text="{Binding Stickers.StickerPagesStatus}" 
                   FontSize="11" Foreground="#888" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Главный чат -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Главный чат" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" 
                  ItemsSource="{Binding Overlays.AvailableModes}"
                  SelectedValue="{Binding Overlays.MainChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="180" 
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Выберите режим отображения"/>
                    </Grid>
                </Border>

                <!-- Важные сообщения -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="❗" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Важные сообщения" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <RadioButton Content="🤖 авто" 
                         IsChecked="{Binding Alerts.ImportantPlaybackMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Auto}"
                         Margin="0,0,5,0"
                         Padding="10,5"
                         Background="{Binding Alerts.ImportantPlaybackMode, Converter={StaticResource PlaybackModeToColorConverter}, ConverterParameter=Auto}"
                         Foreground="White"
                         BorderThickness="1"
                         BorderBrush="#888">
                                <RadioButton.Resources>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="#555"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Resources>
                            </RadioButton>

                            <RadioButton Content="🎮 ручн" 
                         IsChecked="{Binding Alerts.ImportantPlaybackMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Manual}"
                         Margin="0,0,5,0"
                         Padding="10,5"
                         Background="{Binding Alerts.ImportantPlaybackMode, Converter={StaticResource PlaybackModeToColorConverter}, ConverterParameter=Manual}"
                         Foreground="White"
                         BorderThickness="1"
                         BorderBrush="#888">
                                <RadioButton.Resources>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="#555"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Resources>
                            </RadioButton>

                            <Border Background="#FFE0E0" CornerRadius="4" Padding="5,2" Margin="5,0,0,0"
                    Visibility="{Binding Alerts.ImportantPlaybackMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Manual}">
                                <TextBlock Text="{Binding Alerts.ImportantQueueCount, StringFormat='📋 {0}'}" 
                           FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <ToggleButton Grid.Row="1" Grid.Column="1" Content="🔄 Режим чтения" 
              IsChecked="{Binding Alerts.IsAutoSwitchingEnabled}"
              Style="{StaticResource AutoSwitchToggleButtonStyle}"
              Width="90" Height="28" Margin="5,0"
              ToolTip="Автоматически переключать режим в зависимости от очереди"/>

                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="🔊 звук:" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="80" Minimum="0" Maximum="100" 
                    Value="{Binding AudioSettings.ImportantSoundVolume, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AudioSettings.ImportantSoundVolume, StringFormat={}{0}%}" 
                       FontSize="10" Margin="5,0,0,0" Width="35"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="🎤 голос:" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="80" Minimum="0" Maximum="100" 
                    Value="{Binding AudioSettings.VoiceVolume, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AudioSettings.VoiceVolume, StringFormat={}{0}%}" 
                       FontSize="10" Margin="5,0,0,0" Width="35"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Скорость" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider 
    x:Name="VoiceRateSlider"
    Minimum="-10" 
    Maximum="10" 
    Value="{Binding AudioSettings.VoiceRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Width="100"
    VerticalAlignment="Center"
    TickFrequency="1"
    IsSnapToTickEnabled="True"
    ToolTip="Скорость речи (от -10 до 10)"/>
                            <TextBlock Text="{Binding AudioSettings.VoiceRate}" Width="25" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>

                            <Button Content="🐢" Width="30" Height="25" Margin="2,0" 
                Command="{Binding AudioSettings.SetVoiceRateCommand}" CommandParameter="-3"
                ToolTip="Медленно"/>
                            <Button Content="🐇" Width="30" Height="25" Margin="2,0" 
                Command="{Binding AudioSettings.SetVoiceRateCommand}" CommandParameter="5"
                ToolTip="Быстро"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                    Visibility="{Binding Alerts.ImportantPlaybackMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Manual}">
                            <TextBlock Text="⌨️" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="70" Height="24" 
                      Text="{Binding Alerts.ImportantPlaybackHotkey, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Горячая клавиша (например, F8)"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <ComboBox Grid.Row="1" Grid.Column="5"
                  ItemsSource="{Binding Overlays.AvailableModes}"
                  SelectedValue="{Binding Overlays.ImportantChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="150" 
                  Margin="20,10,0,0"
                  VerticalAlignment="Top"/>

                        <StackPanel Grid.Row="0" Grid.Column="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,5,0,0">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding Overlays.ToggleImportantOverlayCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 🔔 Алерты (DonationAlerts / DonationPay) -->
                <Border Background="#FFF8E1" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔔" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Алерты (донаты)" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="100"
                                    Minimum="3"
                                    Maximum="30"
                                    Value="{Binding Settings.AlertsAlertDuration, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Settings.AlertsAlertDuration, StringFormat={}{0}сек}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0"
                                    ToolTip="Показать/скрыть оверлей алертов"
                                    Click="ToggleAlertsOverlay_Click"/>
                            <Button Content="⚙️" Width="30" Height="30"
                                    ToolTip="Настройки алертов"
                                    Click="OpenAlertsSettings_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Шорты -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📱" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Шорты" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" 
                  ItemsSource="{Binding Overlays.AvailableModes}"
                  SelectedValue="{Binding Overlays.ShortsChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="180" 
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Выберите режим отображения"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding Overlays.ToggleShortsOverlayCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Стикеры -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🎨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Стикеры" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="100" 
                    Minimum="2000" 
                    Maximum="15000" 
                    Value="{Binding AudioSettings.StickerDisplayTime, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="1000"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AudioSettings.StickerDisplayTime, StringFormat={}{0}мс}" 
                       FontSize="11" 
                       VerticalAlignment="Center" 
                       Margin="5,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding Overlays.ToggleStickersOverlayCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Дашборд -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Дашборд" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                                    ToolTip="Показать/скрыть"
                                    Command="{Binding Overlays.ToggleDashboardCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- РОТАЦИЯ СТАТИСТИКИ (ТОПЫ) В ОВЕРЛЕЕ АЛЕРТОВ               -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="6" Background="#F3E5F5" BorderBrush="#CE93D8" BorderThickness="0,1,0,1" Padding="10" Margin="0,5,0,0">
            <StackPanel>

                <!-- Заголовок + статус + таймер -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                       Text="📊 Статистика (топы)"
                       FontSize="14" FontWeight="Bold" Foreground="#6A1B9A"/>

                    <TextBlock Grid.Column="1"
                       Text="{Binding Stats.Status}"
                       FontSize="11"
                       Foreground="#888"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

                    <Border Grid.Column="2"
                    Background="#FFF9C4"
                    BorderBrush="#FBC02D"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Stats.CountdownText}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#F57F17"
                               VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Галка включения -->
                <CheckBox Content="Включить ротацию статистики в оверлее алертов"
                  IsChecked="{Binding Stats.IsEnabled}"
                  FontWeight="SemiBold"
                  Margin="0,0,0,8"/>

                <!-- Слайдер интервала тишины -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                       Text="⏱ Тишина (сек):"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                    <Slider Grid.Column="1"
                    Minimum="5"
                    Maximum="300"
                    Value="{Binding Stats.SilenceInterval, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                       Text="{Binding Stats.SilenceInterval, StringFormat={}{0}с}"
                       Width="40"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
                </Grid>

                <!-- Прогресс-бар до следующего показа -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                       Text="⏳ До показа:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                    <ProgressBar Grid.Column="1"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding Stats.CountdownProgress, Mode=OneWay}"
                         Height="10"
                         VerticalAlignment="Center"
                         Background="#EDE7F6"
                         Foreground="#7E57C2"/>
                </Grid>

                <!-- Активные правила -->
                <TextBlock Text="Активные правила:"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#5E35B1"
                   Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding Stats.Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}"
                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                      Command="{Binding DataContext.Stats.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      Margin="10,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
        </Border>
       

    </Grid>
    </ScrollViewer>
</Window>