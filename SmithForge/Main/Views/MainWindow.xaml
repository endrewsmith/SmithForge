<Window x:Class="SmithForge.Main.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Main.Views"
        xmlns:converters="clr-namespace:SmithForge.Main.Converters"
        mc:Ignorable="d"
        Title="SmithForge" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <converters:PlaybackModeToColorConverter x:Key="PlaybackModeToColorConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:PlatformToVisibilityConverter x:Key="PlatformToVisibilityConverter"/>
        <converters:YouTubeMethodToVisibilityConverter x:Key="YouTubeMethodToVisibilityConverter"/>
        <converters:YouTubeMethodNotToVisibilityConverter x:Key="YouTubeMethodNotToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Стиль для ToggleButton -->
        <Style x:Key="AutoSwitchToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#388E3C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C0C0C0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#66BB6A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- МЕНЮ (Строка 0) -->
        <Menu Grid.Row="0" Background="White" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Header="База данных зрителей" Click="OpenChaters_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="👥"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="История стримов" Click="OpenStreams_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎬"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Дашборд (скрытый чат)" Click="ToggleDashboard_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📊"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Важные сообщения" Click="ToggleImportantOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="❗"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Стикеры" Click="ToggleStickersOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Платформы">
                <MenuItem Header="🟣 Twitch.tv" IsHitTestVisible="False" FontWeight="Bold" Foreground="#6441a5"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateTwitch, UpdateSourceTrigger=PropertyChanged, Delay=800, ConverterCulture='en-US'}" 
                                     Width="50" 
                                     HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"
                                     CommandManager.PreviewExecuted="TextBox_PreviewExecuted"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="🔴 YouTube" IsHitTestVisible="False" FontWeight="Bold" Foreground="#FF0000"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateYouTube, Delay=800, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="50" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="🔵 GoodGame.ru" IsHitTestVisible="False" FontWeight="Bold" Foreground="#007bff"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateGoodGame, Delay=800, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="50" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="💾 Применить и сохранить" Command="{Binding SaveSettingsCommand}" FontWeight="Bold"/>
            </MenuItem>
            <MenuItem Header="Shorts Overlay" Click="ToggleShortsOverlay_Click"/>
            <MenuItem Header="YouTube Manager" Click="OpenYouTubeManager_Click"/>
        </Menu>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (Строка 1) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,5">
            <Button Content="СТАРТ" Command="{Binding StartCommand}" 
                    Background="LightBlue" Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="СТОП" Command="{Binding StopCommand}" 
                    Background="LightCoral" Width="100" Height="30"/>
            <CheckBox Content="Показать окна чатов" 
                      IsChecked="{Binding IsOverlaySetupMode}" 
                      VerticalAlignment="Center" 
                      Margin="20,0,0,0"
                      FontSize="14" FontWeight="Bold"/>
            <CheckBox Content="Спрятать окна" 
                      IsChecked="{Binding IsOverlayHidden}" 
                      VerticalAlignment="Center" 
                      Margin="20,0,0,0"
                      FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- ПОЛОСКА СТРИМА (Строка 2) -->
        <Border Grid.Row="2" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding LastStreamNumber, StringFormat='Был номер: {0}', FallbackValue='Был номер: 0'}" 
                               FontSize="10" 
                               Foreground="#A1887F" 
                               FontWeight="Bold"
                               Margin="62,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="СТРИМ №" FontWeight="Bold" VerticalAlignment="Center" Foreground="#795548"/>
                        <TextBox Text="{Binding CurrentSession.Number, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="100" Height="24" Margin="5,0,0,0" 
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 FontWeight="Bold" Foreground="#E65100"
                                 PreviewTextInput="IntegerValidationTextBox"
                                 CommandManager.PreviewExecuted="TextBox_PreviewExecuted"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="СЛЕДУЮЩИЙ" Command="{Binding NextStreamCommand}" 
                        Background="LightGreen" Width="100" Height="24" Margin="10,0,20,0"
                        FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock Text="ТЕКУЩАЯ ТЕМА" FontSize="10" Foreground="#A1887F" FontWeight="Bold" Margin="5,0,0,2"/>
                    <TextBox Text="{Binding CurrentSession.Title, UpdateSourceTrigger=PropertyChanged}" 
                             Width="400" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#F5F5FA" BorderBrush="#DDD" BorderThickness="0,1,0,1" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок секции -->
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📡 Мои чаты" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>

                    <TextBlock Grid.Column="1" Text="{Binding Chats.Count, StringFormat='Всего: {0}'}" 
                       FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <Button Grid.Column="2" Content="➕ Добавить чат" 
                    Click="OpenChatManager_Click"
                    Padding="10,5"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
                </Grid>

                <!-- Список чатов -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <ItemsControl ItemsSource="{Binding Chats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444" BorderThickness="1" CornerRadius="5" Margin="0,2" Padding="5" Background="#2D2D30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                        <!-- Иконка платформы -->
                                        <TextBlock Grid.Column="0" Text="{Binding PlatformIcon}" FontSize="20" Margin="5,0"/>

                                        <!-- Информация о чате -->
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="White" FontSize="13"/>

                                            <!-- СТАТУС С ЦВЕТНЫМ ИНДИКАТОРОМ -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <!-- Цветной индикатор статуса -->
                                                <Border Width="8" Height="8" CornerRadius="4" 
                                                Background="{Binding StatusColor}" 
                                                Margin="0,0,5,0" 
                                                VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ShortStatus}" 
                                                   FontSize="12" 
                                                   Foreground="{Binding StatusColor}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding VideoIdDisplay}" 
               FontSize="10" 
               Foreground="Gray" 
               Margin="0,2,0,0"
               Visibility="{Binding IsYouTube, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding ModeDisplay}" FontSize="10" Foreground="Gray"/>
                                            <!-- Метод подключения (для YouTube) -->
                                            <TextBlock Text="{Binding MethodDisplay}" FontSize="9" Foreground="#888"
                                                       Margin="0,1,0,0"
                                                       Visibility="{Binding IsYouTube, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Поле для Video ID + кнопка (только для YouTube) -->
                                            <Grid Margin="0,3,0,0"
                                                  Visibility="{Binding IsYouTube, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" 
                                                         Text="{Binding VideoId, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="130"
                                                         Padding="5"
                                                         VerticalAlignment="Center"
                                                         Background="#2D2D30"
                                                         Foreground="White"
                                                         BorderBrush="#555"
                                                         BorderThickness="1"
                                                         ToolTip="Введите Video ID (11 символов)"/>
                                                <Button Grid.Column="1" 
                                                        Content="▶"
                                                        Width="28"
                                                        Height="24"
                                                        Margin="5,0,0,0"
                                                        Padding="0"
                                                        Background="#4CAF50"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="Подключиться по этому Video ID"
                                                        Command="{Binding DataContext.ConnectByVideoIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="3"
                                                                    BorderThickness="0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#45a049"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Счетчик сообщений -->
                                        <TextBlock Grid.Column="2" Text="{Binding MessageCount}" Margin="10,0" Foreground="Gray"/>

                                        <!-- Кнопка Connect/Disconnect -->
                                        <Button Grid.Column="3" 
        Margin="5,0"
        Padding="8,3"
        Command="{Binding ConnectCommand}">
                                            <!-- ✅ УБРАТЬ Content="🔌 Подключить" -->
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="🔌 Подключить"/>
                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                                            <Setter Property="Content" Value="⏹ Отключить"/>
                                                            <Setter Property="Background" Value="#FF6B6B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Кнопка изменения метода (только для YouTube) -->
                                        <Button Grid.Column="4" 
                                                Content="⚙️"
                                                Command="{Binding DataContext.ChangeMethodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="5,0"
                                                Padding="5,3"
                                                Visibility="{Binding Platform, Converter={StaticResource PlatformToVisibilityConverter}, ConverterParameter='youtube'}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock FontSize="11" Foreground="Gray">
                <Run Text="Активных: "/>
                <Run Text="{Binding ConnectedChatsCount}" FontWeight="Bold" Foreground="#4CAF50"/>
                <Run Text=" | Сообщений: "/>
                <Run Text="{Binding TotalMessagesCount}" FontWeight="Bold" Foreground="#2196F3"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПОСЛЕДНЕЕ СООБЩЕНИЕ (Строка 4) -->
        <Border Grid.Row="4" Background="#F8F8F8" BorderBrush="#DDD" BorderThickness="0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ПОСЛЕДНЕЕ: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastMessageText}" Foreground="DarkGreen" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- СПИСОК ПОЛЬЗОВАТЕЛЕЙ (Строка 5) -->
        <ListBox Grid.Row="5" ItemsSource="{Binding Users}" Margin="10"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Accounts[0].PlatformShort}" 
                                   FontWeight="Bold" 
                                   Foreground="{Binding Accounts[0].PlatformColor}" 
                                   Opacity="0.7"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding EffectiveName}" 
                                   FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="сообщений: " Foreground="Gray" FontSize="11"/>
                            <TextBlock Text="{Binding MessageCount}" FontWeight="Bold" Foreground="#444"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- СТАТУС-БАР (Строка 6) -->
        <StatusBar Grid.Row="6">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="Юзеров в базе: "/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding Users.Count}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <TextBlock Text="{Binding YouTubeStatus}" Margin="20,0,0,0" Foreground="Gray"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <Button Content="✨ Начислить всем кармы +10" 
                Command="{Binding AddKarmaToAllCommand}"
                Background="#FFD966"
                Foreground="#333"
                Padding="10,3"
                Margin="5,0"
                Cursor="Hand"
                ToolTip="Начислить 10 кармы всем активным зрителям">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StatusBarItem>
        </StatusBar>

        <!-- СЕКЦИЯ УПРАВЛЕНИЯ ОКНАМИ ЧАТОВ (Строка 7) -->
        <Border Grid.Row="7" Background="#F0F0F5" BorderBrush="#DDD" BorderThickness="0,1" Padding="10" Margin="0,5,0,0">
            <StackPanel>
                <TextBlock Text="УПРАВЛЕНИЕ ОКНАМИ ЧАТОВ" FontSize="12" FontWeight="Bold" Foreground="#5C6BC0" Margin="0,0,0,8"/>

                <!-- Главный чат -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Главный чат" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" 
                  ItemsSource="{Binding AvailableModes}"
                  SelectedValue="{Binding MainChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="180" 
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Выберите режим отображения"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleMainChatCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureMainChatCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Шорты -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📱" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Шорты" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" 
                  ItemsSource="{Binding AvailableModes}"
                  SelectedValue="{Binding ShortsChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="180" 
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Выберите режим отображения"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleShortsOverlayCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureShortsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Важные сообщения -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Строка 0: Иконка и название -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="❗" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Важные сообщения" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <!-- Строка 0: Переключатель режима -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <RadioButton Content="🤖 авто" 
                         IsChecked="{Binding ImportantPlaybackMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Auto}"
                         Margin="0,0,5,0"
                         Padding="10,5"
                         Background="{Binding ImportantPlaybackMode, Converter={StaticResource PlaybackModeToColorConverter}, ConverterParameter=Auto}"
                         Foreground="White"
                         BorderThickness="1"
                         BorderBrush="#888">
                                <RadioButton.Resources>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="#555"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Resources>
                            </RadioButton>

                            <RadioButton Content="🎮 ручн" 
                         IsChecked="{Binding ImportantPlaybackMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Manual}"
                         Margin="0,0,5,0"
                         Padding="10,5"
                         Background="{Binding ImportantPlaybackMode, Converter={StaticResource PlaybackModeToColorConverter}, ConverterParameter=Manual}"
                         Foreground="White"
                         BorderThickness="1"
                         BorderBrush="#888">
                                <RadioButton.Resources>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="#555"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Resources>
                            </RadioButton>

                            <Border Background="#FFE0E0" CornerRadius="4" Padding="5,2" Margin="5,0,0,0"
                    Visibility="{Binding ImportantPlaybackMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Manual}">
                                <TextBlock Text="{Binding ImportantQueueCount, StringFormat='📋 {0}'}" 
                           FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <!-- Кнопка авто-переключения режимов -->
                        <ToggleButton Grid.Row="1" Grid.Column="1" Content="🔄 Режим чтения" 
              IsChecked="{Binding IsAutoSwitchingEnabled}"
              Style="{StaticResource AutoSwitchToggleButtonStyle}"
              Width="90" Height="28" Margin="5,0"
              ToolTip="Автоматически переключать режим в зависимости от очереди"/>
                        <!-- Строка 0: Громкость звука -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="🔊 звук:" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="80" Minimum="0" Maximum="100" 
                    Value="{Binding ImportantSoundVolume, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ImportantSoundVolume, StringFormat={}{0}%}" 
                       FontSize="10" Margin="5,0,0,0" Width="35"/>
                        </StackPanel>

                        <!-- Строка 0: Громкость голоса -->
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="🎤 голос:" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="80" Minimum="0" Maximum="100" 
                    Value="{Binding VoiceVolume, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding VoiceVolume, StringFormat={}{0}%}" 
                       FontSize="10" Margin="5,0,0,0" Width="35"/>
                        </StackPanel>

                        <!-- ⚡ СКОРОСТЬ РЕЧИ -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Скорость" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider 
    x:Name="VoiceRateSlider"
    Minimum="-10" 
    Maximum="10" 
    Value="{Binding VoiceRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Width="100"
    VerticalAlignment="Center"
    TickFrequency="1"
    IsSnapToTickEnabled="True"
    ToolTip="Скорость речи (от -10 до 10)"/>
                            <TextBlock Text="{Binding VoiceRate}" Width="25" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>

                            <!-- Кнопки быстрой установки -->
                            <Button Content="🐢" Width="30" Height="25" Margin="2,0" 
                Command="{Binding SetVoiceRateCommand}" CommandParameter="-3"
                ToolTip="Медленно"/>
                            <Button Content="🐇" Width="30" Height="25" Margin="2,0" 
                Command="{Binding SetVoiceRateCommand}" CommandParameter="5"
                ToolTip="Быстро"/>
                        </StackPanel>

                        <!-- Строка 0: Горячая клавиша -->
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                    Visibility="{Binding ImportantPlaybackMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Manual}">
                            <TextBlock Text="⌨️" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox Width="70" Height="24" 
                      ItemsSource="{Binding AvailableHotkeys}"
                      SelectedItem="{Binding ImportantPlaybackHotkey}"
                      IsEditable="True"
                      ToolTip="Выберите горячую клавишу для воспроизведения"/>
                        </StackPanel>

                        <!-- Строка 1: Режим отображения и кнопки -->
                        <ComboBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                  ItemsSource="{Binding AvailableModes}"
                  SelectedValue="{Binding ImportantChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="150" 
                  Margin="20,10,0,0"
                  VerticalAlignment="Top"/>

                        <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,5,0,0">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleImportantOverlayCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureImportantCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Стикеры -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🎨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Стикеры" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <!-- НАСТРОЙКА ПРОДОЛЖИТЕЛЬНОСТИ -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="100" 
                    Minimum="2000" 
                    Maximum="15000" 
                    Value="{Binding StickerDisplayTime, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="1000"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StickerDisplayTime, StringFormat={}{0}мс}" 
                       FontSize="11" 
                       VerticalAlignment="Center" 
                       Margin="5,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleStickersOverlayCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureStickersCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Дашборд -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Дашборд" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                                    ToolTip="Показать/скрыть"
                                    Command="{Binding ToggleDashboardCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                                    ToolTip="Настройки"
                                    Command="{Binding ConfigureDashboardCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================================== -->
        <!-- YOUTUBE СЕКЦИЯ (Строка 8) -->
        <!-- ========================================================== -->
        <Border Grid.Row="8" Background="#FFF8F8" BorderBrush="#FFCDD2" BorderThickness="0,1,0,1" Padding="10" Margin="0,5,0,0">
            <StackPanel>
                <!-- Заголовок -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔴 YouTube" FontSize="14" FontWeight="Bold" Foreground="#C62828" Margin="0,0,15,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding YouTubeStatus}" FontWeight="SemiBold" Foreground="#666"/>
                    <Border Grid.Column="2" CornerRadius="3" Background="#E53935">
                        <Button Content="🔄 Обновить" Command="{Binding LoadYouTubeStreamsCommand}" 
            Width="100" Height="25" Background="Transparent" 
            Foreground="White" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Border.CornerRadius" Value="3"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                </Grid>

                <!-- Настройки YouTube -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel ID:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.YouTube.ChannelId, UpdateSourceTrigger=PropertyChanged}" 
                             Height="24" Margin="0,2,10,2" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.YouTube.ApiKey, UpdateSourceTrigger=PropertyChanged}" 
                             Height="24" Margin="0,2,10,2" VerticalContentAlignment="Center"/>

                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                              Content="Автоподключение к первому стриму" 
                              IsChecked="{Binding Settings.YouTube.AutoConnect}"
                              VerticalAlignment="Center" Margin="0,2,0,2"/>

                    <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="💾 Сохранить" Command="{Binding SaveSettingsCommand}" 
                                Width="90" Height="30" Margin="0,0,5,0"/>
                        <Button Content="🎯 Выбрать стрим" Command="{Binding LoadYouTubeStreamsCommand}" 
                                Width="100" Height="30" Margin="0,0,5,0"/>
                        <Button Content="🔗 Подключиться" Command="{Binding ConnectYouTubeChatCommand}" 
                                Width="100" Height="30" Margin="0,0,5,0" Background="#43A047" Foreground="White"/>
                        <Button Content="⏹ Отключиться" Command="{Binding DisconnectYouTubeChatCommand}" 
                                Width="100" Height="30" Background="#E53935" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- Список стримов -->
                <Border Background="White" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" ItemsSource="{Binding YouTubeStreams}" 
                                 SelectedItem="{Binding SelectedYouTubeStream}"
                                 Height="80" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="3" Padding="5" Margin="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding VideoId}" FontSize="10" Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding IsShorts, Converter={StaticResource BoolToTextConverter}}" 
                                                       FontSize="10" Foreground="{Binding IsShorts, Converter={StaticResource BoolToColorConverter}}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="5" VerticalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="20"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Информация о подключении -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📺" FontSize="14" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding YouTubeVideoId, StringFormat='Video ID: {0}'}" 
                               FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding IsYouTubeConnected, StringFormat='Статус: {0}'}" 
                               FontSize="11" Foreground="{Binding IsYouTubeConnected, Converter={StaticResource BoolToColorConverter}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- СТАТУС-БАР НИЖНИЙ (Строка 9) -->
        <StatusBar Grid.Row="9" Background="#F5F5F5">
            <StatusBarItem>
                <TextBlock Text="YouTube: " Foreground="Gray"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding YouTubeStatus}" Foreground="Gray"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding IsYouTubeConnected, StringFormat='Подключен: {0}'}" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>