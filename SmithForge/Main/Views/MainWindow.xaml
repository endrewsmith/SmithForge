<Window x:Class="SmithForge.Main.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmithForge.Main.Views"
        mc:Ignorable="d"
        Title="SmithForge" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- МЕНЮ (Строка 0) -->
        <Menu Grid.Row="0" Background="White" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Header="База данных зрителей" Click="OpenChaters_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="👥"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="История стримов" Click="OpenStreams_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎬"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Дашборд (скрытый чат)" Click="ToggleDashboard_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📊"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Важные сообщения" Click="ToggleImportantOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="❗"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Стикеры" Click="ToggleStickersOverlay_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Платформы">
                <MenuItem Header="🟣 Twitch.tv" IsHitTestVisible="False" FontWeight="Bold" Foreground="#6441a5"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateTwitch, UpdateSourceTrigger=PropertyChanged, Delay=800, ConverterCulture='en-US'}" 
                                     Width="50" 
                                     HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"
                                     CommandManager.PreviewExecuted="TextBox_PreviewExecuted"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="🔴 YouTube" IsHitTestVisible="False" FontWeight="Bold" Foreground="#FF0000"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateYouTube, Delay=800, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="50" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="🔵 GoodGame.ru" IsHitTestVisible="False" FontWeight="Bold" Foreground="#007bff"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Множитель: x" VerticalAlignment="Center" Width="90"/>
                            <TextBox Text="{Binding Settings.KarmaRateGoodGame, Delay=800, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="50" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DecimalValidationTextBox"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="💾 Применить и сохранить" Command="{Binding SaveSettingsCommand}" FontWeight="Bold"/>
            </MenuItem>
            <MenuItem Header="Shorts Overlay" Click="ToggleShortsOverlay_Click"/>
        </Menu>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (Строка 1) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,5">
            <Button Content="СТАРТ" Command="{Binding StartCommand}" 
                    Background="LightBlue" Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="СТОП" Command="{Binding StopCommand}" 
                    Background="LightCoral" Width="100" Height="30"/>
            <CheckBox Content="Показать окна чатов" 
                      IsChecked="{Binding IsOverlaySetupMode}" 
                      VerticalAlignment="Center" 
                      Margin="20,0,0,0"
                      FontSize="14" FontWeight="Bold"/>
            <CheckBox Content="Спрятать окна" 
                      IsChecked="{Binding IsOverlayHidden}" 
                      VerticalAlignment="Center" 
                      Margin="20,0,0,0"
                      FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- ПОЛОСКА СТРИМА (Строка 2) -->
        <Border Grid.Row="2" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding LastStreamNumber, StringFormat='Был номер: {0}', FallbackValue='Был номер: 0'}" 
                               FontSize="10" 
                               Foreground="#A1887F" 
                               FontWeight="Bold"
                               Margin="62,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="СТРИМ №" FontWeight="Bold" VerticalAlignment="Center" Foreground="#795548"/>
                        <TextBox Text="{Binding CurrentSession.Number, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="100" Height="24" Margin="5,0,0,0" 
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 FontWeight="Bold" Foreground="#E65100"
                                 PreviewTextInput="IntegerValidationTextBox"
                                 CommandManager.PreviewExecuted="TextBox_PreviewExecuted"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="СЛЕДУЮЩИЙ" Command="{Binding NextStreamCommand}" 
                        Background="LightGreen" Width="100" Height="24" Margin="10,0,20,0"
                        FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock Text="ТЕКУЩАЯ ТЕМА" FontSize="10" Foreground="#A1887F" FontWeight="Bold" Margin="5,0,0,2"/>
                    <TextBox Text="{Binding CurrentSession.Title, UpdateSourceTrigger=PropertyChanged}" 
                             Width="400" Height="24" VerticalContentAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ПОСЛЕДНЕЕ СООБЩЕНИЕ (Строка 3) -->
        <Border Grid.Row="3" Background="#F8F8F8" BorderBrush="#DDD" BorderThickness="0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ПОСЛЕДНЕЕ: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastMessageText}" Foreground="DarkGreen" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- СПИСОК ПОЛЬЗОВАТЕЛЕЙ (Строка 4) -->
        <ListBox Grid.Row="4" ItemsSource="{Binding Users}" Margin="10"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Accounts[0].PlatformShort}" 
                                   FontWeight="Bold" 
                                   Foreground="{Binding Accounts[0].PlatformColor}" 
                                   Opacity="0.7"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding EffectiveName}" 
                                   FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="сообщений: " Foreground="Gray" FontSize="11"/>
                            <TextBlock Text="{Binding MessageCount}" FontWeight="Bold" Foreground="#444"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- СТАТУС-БАР (Строка 5) -->
        <StatusBar Grid.Row="5">
            <TextBlock Text="Юзеров в базе: "/>
            <TextBlock Text="{Binding Users.Count}"/>
        </StatusBar>

        <!-- СЕКЦИЯ УПРАВЛЕНИЯ ОКНАМИ ЧАТОВ (Строка 6) -->
        <Border Grid.Row="6" Background="#F0F0F5" BorderBrush="#DDD" BorderThickness="0,1" Padding="10" Margin="0,5,0,0">
            <StackPanel>
                <TextBlock Text="УПРАВЛЕНИЕ ОКНАМИ ЧАТОВ" FontSize="12" FontWeight="Bold" Foreground="#5C6BC0" Margin="0,0,0,8"/>

                <!-- Главный чат -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Главный чат" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" 
                  ItemsSource="{Binding AvailableModes}"
                  SelectedValue="{Binding MainChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="180" 
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Выберите режим отображения"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleMainChatCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureMainChatCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Шорты -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📱" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Шорты" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" 
                  ItemsSource="{Binding AvailableModes}"
                  SelectedValue="{Binding ShortsChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="180" 
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Выберите режим отображения"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleShortsOverlayCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureShortsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Важные сообщения -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="❗" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Важные сообщения" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" 
                  ItemsSource="{Binding AvailableModes}"
                  SelectedValue="{Binding ImportantChatMode}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name"
                  Width="180" 
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Выберите режим отображения"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleImportantOverlayCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureImportantCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Стикеры -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🎨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Стикеры" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <!-- НАСТРОЙКА ПРОДОЛЖИТЕЛЬНОСТИ -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Slider Width="100" 
                    Minimum="2000" 
                    Maximum="15000" 
                    Value="{Binding StickerDisplayTime, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="1000"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StickerDisplayTime, StringFormat={}{0}мс}" 
                       FontSize="11" 
                       VerticalAlignment="Center" 
                       Margin="5,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                    ToolTip="Показать/скрыть"
                    Command="{Binding ToggleStickersOverlayCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                    ToolTip="Настройки"
                    Command="{Binding ConfigureStickersCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Дашборд -->
                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Дашборд" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="👁️" Width="30" Height="30" Margin="0,0,5,0" 
                                    ToolTip="Показать/скрыть"
                                    Command="{Binding ToggleDashboardCommand}"/>
                            <Button Content="⚙️" Width="30" Height="30" 
                                    ToolTip="Настройки"
                                    Command="{Binding ConfigureDashboardCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>