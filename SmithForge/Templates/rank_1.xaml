<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:SmithForge.Features.ChatOverlay;assembly=SmithForge">


    <!-- Конвертер ранга в цвет -->
    <utils:RankToColorConverter x:Key="RankToColorConverter"/>

    <!-- Шаблон сообщения чата -->
    <DataTemplate x:Key="ChatMessageTemplate">
        <Border x:Name="MsgContainer" 
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8,4" 
                Margin="2,4" 
                Opacity="0">
            
            <Border.RenderTransform>
                <TranslateTransform x:Name="MsgTransform" X="-30"/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- ВЕРХНЯЯ ОБЛАСТЬ (звезды ранга и карма) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#FFD700"/>
                        <TextBlock x:Name="Star2" Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#333333"/>
                        <TextBlock x:Name="Star3" Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#333333"/>
                        <TextBlock x:Name="Star4" Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#333333"/>
                        <TextBlock x:Name="Star5" Text="★" FontSize="11" Foreground="#333333"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding User.KarmaDisplay}" Foreground="#00E5FF" FontSize="10" FontWeight="Bold" Margin="0,0,2,0"/>
                        <TextBlock Text="⚡" Foreground="#00E5FF" FontSize="10"/>
                    </StackPanel>
                </Grid>

                <!-- СРЕДНЯЯ ОБЛАСТЬ (номер + имя + текст) -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    
                    <!-- НОМЕР СООБЩЕНИЯ С ЦВЕТОМ РАНГА -->
                    <Border Background="{Binding UserRank, Converter={StaticResource RankToColorConverter}}" 
                            CornerRadius="3" 
                            Padding="4,1" 
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding MessageNumber, StringFormat=#{0}}" 
                                   Foreground="White" 
                                   FontSize="9" 
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock x:Name="UserNickname" 
                               Text="{Binding DisplayName}" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               FontSize="13"/>
                    
                    <TextBlock Text=": " Foreground="White"/>
                    
                    <TextBlock Text="{Binding MessageText}" 
                               Foreground="White" 
                               TextWrapping="Wrap" 
                               FontSize="13"/>
                </StackPanel>

                <!-- НИЖНЯЯ ОБЛАСТЬ (статистика) -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Всего: " Foreground="#666666" FontSize="9"/>
                        <TextBlock Text="{Binding MessageCount}" Foreground="#666666" FontSize="9"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="+" Foreground="#4CAF50" FontSize="12" FontWeight="Bold" Margin="0,-2,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="0" Foreground="#4CAF50" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="-" Foreground="#F44336" FontSize="14" FontWeight="Bold" Margin="0,-2,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="0" Foreground="#F44336" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Анимация появления -->
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                            <DoubleAnimation Storyboard.TargetName="MsgTransform"
                                             Storyboard.TargetProperty="X" 
                                             From="-30" To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <!-- Триггеры для смены цвета ника и звезд -->
        <DataTemplate.Triggers>
            <!-- Цвет ника по платформе -->
            <DataTrigger Binding="{Binding Type}" Value="tw">
                <Setter TargetName="UserNickname" Property="Foreground" Value="#9146FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="twitch">
                <Setter TargetName="UserNickname" Property="Foreground" Value="#9146FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="yt">
                <Setter TargetName="UserNickname" Property="Foreground" Value="#FF0000"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="youtube">
                <Setter TargetName="UserNickname" Property="Foreground" Value="#FF0000"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="gg">
                <Setter TargetName="UserNickname" Property="Foreground" Value="#00A550"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="goodgame">
                <Setter TargetName="UserNickname" Property="Foreground" Value="#00A550"/>
            </DataTrigger>

            <!-- Звезды ранга -->
            <DataTrigger Binding="{Binding UserRank}" Value="2">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding UserRank}" Value="3">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star3" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding UserRank}" Value="4">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star3" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star4" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding UserRank}" Value="5">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star3" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star4" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star5" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>