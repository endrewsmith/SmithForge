<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:SmithForge.Features.ChatOverlay;assembly=SmithForge">

    <!-- Конвертер ранга в цвет -->
    <utils:RankToColorConverter x:Key="RankToColorConverter"/>

    <DataTemplate x:Key="ChatMessageTemplate">
        <Border x:Name="MsgContainer" 
                Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="8,4" 
                Margin="2,4">
            
            <StackPanel>
                <!-- ВЕРХНЯЯ ОБЛАСТЬ (звезды ранга и карма) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#FFD700"/>
                        <TextBlock x:Name="Star2" Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#333333"/>
                        <TextBlock x:Name="Star3" Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#333333"/>
                        <TextBlock x:Name="Star4" Text="★" FontSize="11" Margin="0,0,1,0" Foreground="#333333"/>
                        <TextBlock x:Name="Star5" Text="★" FontSize="11" Foreground="#333333"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding User.KarmaDisplay}" Foreground="#00E5FF" FontSize="10" FontWeight="Bold" Margin="0,0,2,0"/>
                        <TextBlock Text="⚡" Foreground="#00E5FF" FontSize="10"/>
                    </StackPanel>
                </Grid>

                <!-- Текст сообщения: имя: текст -->
                <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap">
                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" Foreground="White"/>
                    <Run Text=": " Foreground="White"/>
                    <Run Text="{Binding MessageText, Mode=OneWay}" Foreground="#F0F0F0"/>
                </TextBlock>
               
                <!-- НИЖНЯЯ ОБЛАСТЬ (статистика) -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="N: " Foreground="#666666" FontSize="9"/>
                        <TextBlock Text="{Binding MessageNumber, Mode=OneWay}" Foreground="#666666" FontSize="9"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="+" Foreground="#4CAF50" FontSize="12" FontWeight="Bold" Margin="0,-2,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="0" Foreground="#4CAF50" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="-" Foreground="#F44336" FontSize="14" FontWeight="Bold" Margin="0,-2,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="0" Foreground="#F44336" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Триггеры -->
        <DataTemplate.Triggers>
            <!-- Цвет ника по платформе - меняем цвет всего TextBlock -->
            <DataTrigger Binding="{Binding Type}" Value="tw">
                <Setter Property="TextElement.Foreground" TargetName="MessageTextBlock" Value="#9146FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="twitch">
                <Setter Property="TextElement.Foreground" TargetName="MessageTextBlock" Value="#9146FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="yt">
                <Setter Property="TextElement.Foreground" TargetName="MessageTextBlock" Value="#FF0000"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="youtube">
                <Setter Property="TextElement.Foreground" TargetName="MessageTextBlock" Value="#FF0000"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="gg">
                <Setter Property="TextElement.Foreground" TargetName="MessageTextBlock" Value="#00A550"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="goodgame">
                <Setter Property="TextElement.Foreground" TargetName="MessageTextBlock" Value="#00A550"/>
            </DataTrigger>

            <!-- Звезды ранга -->
            <DataTrigger Binding="{Binding UserRank}" Value="2">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding UserRank}" Value="3">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star3" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding UserRank}" Value="4">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star3" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star4" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding UserRank}" Value="5">
                <Setter TargetName="Star2" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star3" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star4" Property="Foreground" Value="#FFD700"/>
                <Setter TargetName="Star5" Property="Foreground" Value="#FFD700"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>